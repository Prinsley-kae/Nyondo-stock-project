doctype html
html
  head
    title #{reportTitle || 'Sales Report'}
    style.
      @page { size: A4 landscape; margin: 15mm; }
      body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; padding: 10px; background: #ffffff; color: #333; }
      .container { width: 100%; margin: auto; }
      
      .header-grid { display: flex; justify-content: space-between; border-bottom: 3px solid #333; padding-bottom: 10px; margin-bottom: 20px; }
      .brand h1 { margin: 0; color: #000; text-transform: uppercase; }
      .doc-meta { text-align: right; font-size: 0.85rem; }
      
      .summary-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
      .card { border: 1px solid #ddd; padding: 10px; border-left: 5px solid #333; }
      .card h4 { margin: 0; font-size: 0.7rem; color: #666; text-transform: uppercase; }
      .card p { margin: 5px 0 0 0; font-size: 1.2rem; font-weight: 700; }

      .report-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      .report-table th { background: #333; color: #fff; padding: 8px; font-size: 0.7rem; text-align: left; }
      .report-table td { padding: 8px; border-bottom: 1px solid #eee; font-size: 0.75rem; vertical-align: top; word-wrap: break-word; }
      
      .badge { padding: 2px 5px; border-radius: 3px; font-size: 0.65rem; font-weight: bold; }
      .badge-self { background: #eee; }
      .badge-del { background: #d4edda; }

  body
    .container
      .header-grid
        .brand
          h1 Sales Report
          p(style="margin:0; font-size: 0.8rem;") #{reportTitle}
        .doc-meta
          p <strong>Period:</strong> #{startDate} – #{endDate} | <strong>Prepared By:</strong> #{generatedBy}

      .summary-bar
        .card
          h4 Total Revenue
          p UGX #{(Number(totalRevenue) || 0).toLocaleString()}
        .card
          h4 Total Profit
          p UGX #{(Number(totalProfit) || 0).toLocaleString()}

      table.report-table
        thead
          tr
            th(style="width: 8%") Date
            th(style="width: 10%") Attendant
            th(style="width: 10%") Customer
            th(style="width: 8%") Delivery
            th(style="width: 18%") Items
            th(style="width: 6%") Qty
            th(style="width: 10%") Fee
            th(style="width: 10%") Total
            th(style="width: 10%") Profit
        tbody
          if sales && sales.length > 0
            each sale in sales
              tr
                td= new Date(sale.date).toLocaleDateString('en-GB')
                td= sale.attendant ? sale.attendant.fullname : 'N/A'
                td= sale.customerName || 'Walk-in'
                td
                  //- Logic: If method is self-pick OR distance is 0, it's Self-Pick
                  if sale.deliveryMethod === 'self-pick' || sale.distance === 0
                    span.badge.badge-self Self-Pick
                  else
                    //- Otherwise it is Delivery, and we show the distance
                    span.badge.badge-del Delivery 
                    small(style="display:block; font-size: 9px;") #{sale.distance} KM
                                      
                td
                  each entry in sale.items
                    div • #{entry.item ? entry.item.itemName : 'Deleted'}
                td
                  each entry in sale.items
                    div #{entry.quantity}
                td UGX #{Number(sale.transportFee || 0).toLocaleString()}
                td UGX #{Number(sale.finalTotal || 0).toLocaleString()}
                td UGX #{sale.items.reduce((p, item) => p + (item.unitPrice - (item.item ? item.item.buyingPrice : 0)) * item.quantity, 0).toLocaleString()}
          else
            tr
              td(colspan="9" style="text-align:center; padding:20px;") No transactions found.