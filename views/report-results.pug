doctype html
html
  head
    title Sales Report | #{startDate} - #{endDate}

    link(
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    )

    style.
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px;
        background: #f4f7f6;
        color: #333;
      }

      .container {
        max-width: 1000px;
        margin: auto;
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      }

      /* Navigation */
      .nav-bar {
        margin-bottom: 20px;
      }

      .back-link {
        text-decoration: none;
        color: #666;
        font-size: 0.9rem;
      }

      /* Header & Metadata */
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid #eee;
      }

      .meta-info {
        font-size: 0.85rem;
        color: #777;
        margin-top: 5px;
      }

      /* Summary Cards */
      .report-summary {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
      }

      .report-summary .card {
        padding: 20px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        flex: 1;
        background: #f8f9fa;
      }

      .report-summary .card h4 {
        margin: 0;
        color: #6c757d;
        font-size: 0.8rem;
        text-transform: uppercase;
      }

      .report-summary .card p {
        margin: 10px 0 0 0;
        font-size: 1.5rem;
        font-weight: bold;
        color: #212529;
      }

      /* Table */
      .report-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
      }

      .report-table th {
        background: #343a40;
        color: #ffffff;
        padding: 14px;
        text-align: left;
        font-size: 0.9rem;
      }

      .report-table td {
        border-bottom: 1px solid #eee;
        padding: 12px;
        vertical-align: top;
        font-size: 0.9rem;
      }

      .item-list {
        padding: 4px 0;
        border-bottom: 1px solid #f9f9f9;
      }

      /* Buttons & Print */
      .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        font-weight: bold;
      }

      .primary {
        background-color: #28a745;
        color: white;
      }

      @media print {
        body {
          background: white;
          padding: 0;
        }

        .container {
          box-shadow: none;
          width: 100%;
        }

        .no-print {
          display: none !important;
        }
      }

  body
    .container

      //- Back to Dashboard Link (Dynamic)
      .nav-bar.no-print
        a.back-link(href=backUrl || "/sales")
          i.fa-solid.fa-arrow-left
          |  Back to Dashboard

      .page-header
        div
          h2(style="margin: 0; color: #000;") Sales Report

          .meta-info
            p
              | Report Period: 
              strong  #{startDate} to #{endDate}

            p
              | Generated on: 
              strong  #{new Date().toLocaleString('en-GB')}

            if attendantName
              p
                | Attendant: 
                strong #{attendantName}

        button.btn.primary.no-print(onclick="window.print()")
          i.fa-solid.fa-print(style="margin-right: 8px;")
          |  Print Report

      .report-summary
        .card
          h4 Total Revenue
          p UGX #{(Number(totalRevenue) || 0).toLocaleString()}

        .card
          h4 Total Profit
          p UGX #{(Number(totalProfit) || 0).toLocaleString()}

      table.report-table
        thead
          tr
            th Date
            th Customer
            th Items
            th Qty
            th Transport
            th Total
            th Profit

        tbody
          if sales && sales.length > 0
            each sale in sales
              tr
                td= new Date(sale.date).toLocaleDateString('en-GB')
                td= sale.customerName || 'Walk-in'
                td
                  each entry in sale.items
                    div.item-list
                      = entry.item ? entry.item.itemName : 'Deleted'
                td
                  each entry in sale.items
                    div.item-list
                      = entry.quantity
                td
                  | UGX #{Number(sale.transportFee || 0).toLocaleString()}
                td
                  | UGX #{Number(sale.finalTotal || 0).toLocaleString()}
                td
                  | UGX #{sale.items.reduce((p, item) => p + (item.unitPrice - (item.item ? item.item.buyingPrice : 0)) * item.quantity, 0).toLocaleString()}
          else
            tr
              td(
                colspan="7"
                style="text-align: center; padding: 20px;"
              )
                | No sales found for this period.