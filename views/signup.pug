doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Sign Up - NYONDO Stock System

    //- FONT AWESOME
    link(
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css'
    )

    //- GOOGLE FONTS
    link(
      href='https://fonts.googleapis.com/css2?family=Poppins:wght=300;400;500;600&display=swap'
      rel='stylesheet'
    )

    //- MAIN CSS
    link(rel='stylesheet' href='/css/style.css')

    style.
      /* Small helper style for inline errors if not defined in your style.css */
      .inline-error-msg {
        color: #d9534f;
        font-size: 0.825rem;
        margin-top: 5px;
        margin-left: 2px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
      }

  body

    .auth-container

      .auth-box

        h2 Create Account

        p.subtitle Register to access NYONDO system

        //- System-wide/Database level errors show up here if needed
        if errors && errors.system
          .alert-banner.alert-danger
            i.fa-solid.fa-circle-exclamation
            span= errors.system

        if success_msg && success_msg.length > 0
          .alert-banner.alert-success
            i.fa-solid.fa-circle-check
            span= success_msg

        form(method='post' action='/signup')

          //- =========================
          //- FULL NAME
          //- =========================
          .input-group
            label Full Name

            .icon-input
              i.fa-solid.fa-user

              input(
                type='text'
                name='fullname'
                placeholder='Enter full name'
                value=fullname
                required
              )
            if errors && errors.fullname
              p.inline-error-msg
                i.fa-solid.fa-circle-exclamation
                span= errors.fullname


          //- =========================
          //- EMAIL
          //- =========================
          .input-group
            label Email Address

            .icon-input
              i.fa-solid.fa-envelope

              input(
                type='email'
                name='email'
                placeholder='Enter email address'
                value=email
                required
              )
            if errors && errors.email
              p.inline-error-msg
                i.fa-solid.fa-circle-exclamation
                span= errors.email


          //- =========================
          //- PHONE NUMBER
          //- =========================
          .input-group
            label Phone Number

            .phone-input

              span.phone-prefix +256

              input(
                type='text'
                name='phonenumber'
                placeholder='7XXXXXXXX'
                maxlength='10'
                value=phonenumber
                required
              )
            if errors && errors.phonenumber
              p.inline-error-msg
                i.fa-solid.fa-circle-exclamation
                span= errors.phonenumber


          //- =========================
          //- NIN
          //- =========================
          .input-group
            label NIN Number

            .icon-input
              i.fa-solid.fa-id-card

              input(
                type='text'
                name='nin'
                placeholder='Enter NIN number'
                value=nin
                required
              )
            if errors && errors.nin
              p.inline-error-msg
                i.fa-solid.fa-circle-exclamation
                span= errors.nin


          //- =========================
          //- ROLE
          //- =========================
          .input-group
            label Role

            select(name='role' required)
              option(value='' disabled selected=(!role))
                | Select role

              option(value='sales_attendant' selected=(role === 'sales_attendant'))
                | Sales Attendant

              option(value='store_manager' selected=(role === 'store_manager'))
                | Store Manager

              option(value='admin' selected=(role === 'admin'))
                | Admin / Accounts


          //- =========================
          //- PASSWORD
          //- =========================
          .input-group
            label Password

            .password-wrapper

              input(
                type='password'
                name='password'
                id='signupPassword'
                placeholder='Create password'
                required
              )

              span.toggle-password(
                onclick='toggleSignupPassword(event)'
              )
                i.fa-solid.fa-eye
            if errors && errors.password
              p.inline-error-msg
                i.fa-solid.fa-circle-exclamation
                span= errors.password


          //- =========================
          //- CONFIRM PASSWORD
          //- =========================
          .input-group
            label Confirm Password

            .password-wrapper

              input(
                type='password'
                name='confirmPassword'
                id='confirmPassword'
                placeholder='Confirm password'
                required
              )

              span.toggle-password(
                onclick='toggleConfirmPassword(event)'
              )
                i.fa-solid.fa-eye
            if errors && errors.confirmPassword
              p.inline-error-msg
                i.fa-solid.fa-circle-exclamation
                span= errors.confirmPassword


          //- =========================
          //- SUBMIT BUTTON
          //- =========================
          button.btn.primary(type='submit')

            i.fa-solid.fa-user-plus

            |  Sign Up


        //- =========================
        //- LOGIN LINK
        //- =========================
        .auth-links

          p
            | Already have an account?

            a(href='/login')
              |  Login


    //- =========================
    //- FOOTER
    //- =========================
    footer

      p
        | © 2026 NYONDO General Hardware LTD

      p
        | i.fa-solid.fa-location-dot

        |   Nansana, Uganda


    script(src='/js/script.js')