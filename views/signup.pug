doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sign Up - NYONDO Stock System

    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
    link(href='https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/css/style.css')

    style.
      .input-error { border: 2px solid #ff4d4d !important; }
      .error-message { color: #ff4d4d; font-size: 0.8rem; margin-top: 5px; display: block; }
      .alert-success { background: rgba(46, 204, 113, 0.2); border: 1px solid #2ecc71; color: #27ae60; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
      .alert-danger { background: rgba(255, 77, 77, 0.2); border: 1px solid #ff4d4d; color: #cc0000; padding: 15px; border-radius: 8px; margin-bottom: 20px; }

  body
    .container-signup
      h1 Create Account
      p.subtitle Register to access NYONDO system

      //- Success and Error Messages
      if success_msg && success_msg.length > 0
        .alert-success= success_msg

      if errors && errors.system
        .alert-danger= errors.system

      form(method='post' action='/signup' novalidate)

        //- Helper to apply 'input-error' class if a specific field has an error
        .input-group
          label Full Name
          input(
            type='text'
            name='fullname'
            placeholder='John Doe'
            value=fullname
            required
            class=(errors && errors.fullname ? 'input-error' : '')
          )
          if errors && errors.fullname
            span.error-message= errors.fullname

        .input-group
          label Email Address
          input(
            type='email'
            name='email'
            placeholder='name@company.com'
            value=email
            required
            class=(errors && errors.email ? 'input-error' : '')
          )
          if errors && errors.email
            span.error-message= errors.email

        .input-group
          label Phone Number
          .phone-input(class=(errors && errors.phonenumber ? 'input-error' : ''))
            span.phone-prefix(style="margin-right:10px; color:#6b7280;") +256
            input(
              type='text'
              name='phonenumber'
              placeholder='7XXXXXXXX'
              maxlength='9'
              value=phonenumber
              required
              style="border:none; padding:0; outline:none;"
            )
          if errors && errors.phonenumber
            span.error-message= errors.phonenumber

        .input-group
          label NIN Number
          input(
            type='text'
            name='nin'
            placeholder='Enter NIN'
            value=nin
            required
            class=(errors && errors.nin ? 'input-error' : '')
          )
          if errors && errors.nin
            span.error-message= errors.nin

        .input-group
          label Role
          select(name='role' required class=(errors && errors.role ? 'input-error' : ''))
            option(value='' disabled selected) Select role
            option(value='sales_attendant' selected=(role=='sales_attendant')) Sales Attendant
            option(value='store_manager' selected=(role=='store_manager')) Store Manager
            option(value='admin' selected=(role=='admin')) Admin
          if errors && errors.role
            span.error-message= errors.role

        .input-group
          label Password
          .password-wrapper(class=(errors && errors.password ? 'input-error' : ''))
            input(
              type='password'
              name='password'
              id='signupPass'
              placeholder='••••••••'
              required
            )
            span.toggle-password(onclick="togglePassword('signupPass', this)")
              i.fa-solid.fa-eye
          if errors && errors.password
            span.error-message= errors.password

        .input-group
          label Confirm Password
          .password-wrapper(class=(errors && errors.confirmPassword ? 'input-error' : ''))
            input(
              type='password'
              name='confirmPassword'
              id='confirmPass'
              placeholder='••••••••'
              required
            )
            span.toggle-password(onclick="togglePassword('confirmPass', this)")
              i.fa-solid.fa-eye
          if errors && errors.confirmPassword
            span.error-message= errors.confirmPassword

        button.btn.primary(type='submit')
          i.fa-solid.fa-user-plus
          |  Sign Up

      .auth-links
        p Already have an account?
          a(href='/login') Login

    script(src='/js/script.js')

    script.
      //- Logic to clear red border when typing
      document.querySelectorAll('input, select').forEach(el => {
        el.addEventListener('input', () => {
          el.classList.remove('input-error');

          //- Also clear parent wrapper if it has the error class
          if(el.parentElement.classList.contains('input-error')) {
            el.parentElement.classList.remove('input-error');
          }

          //- Remove error text
          const errorSpan = el.parentElement.nextElementSibling;
          if(errorSpan && errorSpan.classList.contains('error-message')) {
            errorSpan.style.display = 'none';
          }
        });
      });

      function togglePassword(id, el) {
        const input = document.getElementById(id);
        const icon = el.querySelector('i');

        input.type = input.type === 'password' ? 'text' : 'password';
        icon.classList.toggle('fa-eye');
        icon.classList.toggle('fa-eye-slash');
      }

      //- Red inputs on submission of an empty form
      document.querySelector('form').addEventListener('submit', function(e) {
        let hasError = false;
        const inputs = this.querySelectorAll('input, select');

        inputs.forEach(input => {
          //- Check if field is empty
          if (input.value.trim() === '') {
            hasError = true;

            //- 1. Add error class to the input itself
            input.classList.add('input-error');

            //- 2. Also add it to the parent if it's a wrapper (like password/phone)
            const parent = input.parentElement;
            if (parent.classList.contains('password-wrapper') || parent.classList.contains('phone-input')) {
              parent.classList.add('input-error');
            }
          }
        });

        if (hasError) {
          e.preventDefault();
          alert('Please fill in all required fields.');
        }
      });