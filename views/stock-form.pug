extends stock-layout

block content
  // Include the external stylesheet link
  link(rel="stylesheet", href="/css/stock-form.css")

  // ================= PAGE HEADER =================
  .page-header
    h2 Add New Stock
    p.subtitle Record newly received stock items

  // ================= FORM SECTION =================
  .recent-section
    h3 Enter Product & Supplier Details

    form#stockForm.form-section(
      method="POST" 
      action="/store/add-stock" 
      enctype="multipart/form-data"
    )
      //- HIDDEN BATCH ID: Generated by the server or client 
      //- For simplicity, we can auto-generate this on the server, 
      //- but adding this field allows future flexibility.
      input(type="hidden" name="batchId" value=`BTCH-${Date.now().toString().slice(-8)}`)

      .form-grid
        // ========= ITEM NAME =========
        .input-group
          label(for="itemName") Item Name
          select#itemName(name="itemName" required)
            option(value="" disabled selected) -- Select Item --
            option(value="Cement iiN") Cement iiN
            option(value="Cement iiiN") Cement iiiN
            option(value="Iron Sheets") Iron Sheets
            option(value="Nails inc 1") Nails inc 1
            option(value="Nails inc 3") Nails inc 3
            option(value="Nails inc 4") Nails inc 4
            option(value="Nails inc 5") Nails inc 5
            option(value="Iron bars 10mm") Iron bars 10mm
            option(value="Iron bars 12mm") Iron bars 12mm
            option(value="Iron bars 16mm") Iron bars 16mm
            option(value="Gauges") Gauges
            option(value="Wire mesh") Wire mesh
            option(value="Wheel barrows") Wheel barrows
            option(value="High tensile barbed wire") High tensile barbed wire
            option(value="Low tensile barbed wire") Low tensile barbed wire

        // ========= QUANTITY =========
        .input-group
          label(for="quantity") Quantity Received
          input#quantity(type="number" name="quantity" placeholder="E.g., 50" min="1" required)

        // ========= BUYING PRICE =========
        .input-group
          label(for="buyingPrice") Buying Price (UGX)
          input#buyingPrice(type="number" name="buyingPrice" placeholder="E.g., 28000" min="1" required)

        // ========= SELLING PRICE =========
        .input-group
          label(for="sellingPrice") Selling Price (UGX)
          input#sellingPrice(type="number" name="sellingPrice" placeholder="E.g., 33000" min="1" required)

        // ========= SUPPLIER NAME =========
        .input-group
          label(for="supplierName") Supplier Agent Name
          input#supplierName(type="text" name="supplierName" placeholder="E.g., John Doe" required)

        // ========= COMPANY NAME =========
        .input-group
          label(for="companyName") Company / Factory Name
          input#companyName(type="text" name="companyName" placeholder="E.g., Tororo Cement" required)

        // ========= SUPPLIER CONTACT (Sanitized) =========
        .input-group
          label(for="supplierContact") Supplier Contact
          .phone-input(style="display: flex; align-items: center; border: 1px solid #ccc; padding: 5px; border-radius: 4px;")
            span.phone-prefix(style="padding-right: 5px; color: #666;") +256
            input#supplierContact(
              type="text" 
              name="supplierContact" 
              maxlength="9"
              placeholder="771234567" 
              oninput="this.value = this.value.replace(/[^0-9]/g, '');"
              style="border: none; outline: none; width: 100%;"
              required
            )

        // ========= PAYMENT METHOD =========
        .input-group
          label(for="paymentMethod") Payment Method
          select#paymentMethod(name="paymentMethod" required)
            option(value="cash_at_hand") Cash at hand
            option(value="credit") Credit

        // ========= IMAGE =========
        .input-group
          label(for="itemImage") Item Image
          input#itemImage(type="file" name="itemImage" accept="image/*")

      hr.form-divider

      // ================= BUTTONS =================
      .button-group
        button.btn.primary-btn(type="submit")
          i.fa-solid.fa-plus
          |  Save Stock
        button.btn.secondary-btn(type="reset")
          i.fa-solid.fa-rotate-left
          |  Clear Form