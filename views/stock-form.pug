extends stock-layout

block content
  link(rel="stylesheet", href="/css/stock-form.css")

  style.
    .is-invalid { border: 2px solid red !important; }
    .error-message { 
      color: red; 
      font-size: 12px; 
      display: block; 
      margin-top: 5px; 
      font-weight: bold;
    }

  .page-header
    h2 Add New Stock
    p.subtitle Record newly received stock items

  .recent-section
    h3 Enter Product & Supplier Details

    form#stockForm.form-section(
      method="POST"
      action="/store/add-stock"
      enctype="multipart/form-data"
      novalidate
    )
      input(type="hidden" name="batchId" value=`BTCH-${Date.now().toString().slice(-8)}`)

      .form-grid
        //-- ========= ITEM NAME =========
        .input-group
          label(for="itemName") Item Name
          select#itemName(name="itemName" class=(errors && errors.itemName ? 'is-invalid' : ''))
            option(value="" disabled selected=(!data || !data.itemName)) -- Select Item --
            each item in ["Cement iiN", "Cement iiiN", "Iron Sheets", "Nails inc 1", "Nails inc 3", "Nails inc 4", "Nails inc 5", "Iron bars 10mm", "Iron bars 12mm", "Iron bars 16mm", "Gauges", "Wire mesh", "Wheel barrows", "High tensile barbed wire", "Low tensile barbed wire"]
              option(value=item selected=(data && data.itemName === item))= item
          if errors && errors.itemName
            span.error-message= errors.itemName.msg

        //-- ========= QUANTITY =========
        .input-group
          label(for="quantity") Quantity Received
          input#quantity(type="number" name="quantity" placeholder="E.g., 50" value=(data ? data.quantity : '') class=(errors && errors.quantity ? 'is-invalid' : ''))
          if errors && errors.quantity
            span.error-message= errors.quantity.msg

        //-- ========= BUYING PRICE =========
        .input-group
          label(for="buyingPrice") Buying Price (UGX)
          input#buyingPrice(type="number" name="buyingPrice" placeholder="E.g., 28000" value=(data ? data.buyingPrice : '') class=(errors && errors.buyingPrice ? 'is-invalid' : ''))
          if errors && errors.buyingPrice
            span.error-message= errors.buyingPrice.msg

        //-- ========= SELLING PRICE =========
        .input-group
          label(for="sellingPrice") Selling Price (UGX)
          input#sellingPrice(type="number" name="sellingPrice" placeholder="E.g., 33000" value=(data ? data.sellingPrice : '') class=(errors && errors.sellingPrice ? 'is-invalid' : ''))
          if errors && errors.sellingPrice
            span.error-message= errors.sellingPrice.msg

        //-- ========= SUPPLIER NAME =========
        .input-group
          label(for="supplierName") Supplier Agent Name
          input#supplierName(type="text" name="supplierName" placeholder="E.g., John Doe" value=(data ? data.supplierName : '') class=(errors && errors.supplierName ? 'is-invalid' : ''))
          if errors && errors.supplierName
            span.error-message= errors.supplierName.msg

        //-- ========= COMPANY NAME =========
        .input-group
          label(for="companyName") Company / Factory Name
          input#companyName(type="text" name="companyName" placeholder="E.g., Tororo Cement" value=(data ? data.companyName : '') class=(errors && errors.companyName ? 'is-invalid' : ''))
          if errors && errors.companyName
            span.error-message= errors.companyName.msg

        //-- ========= SUPPLIER CONTACT =========
        .input-group
          label(for="supplierContact") Supplier Contact
          .phone-input(style="display: flex; align-items: center; border: 1px solid #ccc; padding: 5px; border-radius: 4px;" class=(errors && errors.supplierContact ? 'is-invalid' : ''))
            span.phone-prefix(style="padding-right: 5px; color: #666;") +256
            input#supplierContact(type="text" name="supplierContact" maxlength="9" placeholder="771234567" value=(data ? data.supplierContact : '') oninput="this.value = this.value.replace(/[^0-9]/g, '');" style="border: none; outline: none; width: 100%;")
          if errors && errors.supplierContact
            span.error-message= errors.supplierContact.msg

        //-- ========= PAYMENT METHOD =========
        .input-group
          label(for="paymentMethod") Payment Method
          select#paymentMethod(name="paymentMethod")
            option(value="cash_at_hand" selected=(data && data.paymentMethod === 'cash_at_hand')) Cash at hand
            option(value="credit" selected=(data && data.paymentMethod === 'credit')) Credit

        //-- ========= IMAGE =========
        .input-group
          label(for="itemImage") Item Image
          input#itemImage(type="file" name="itemImage" accept="image/*")

      hr.form-divider

      .button-group
        button.btn.primary-btn(type="submit")
          i.fa-solid.fa-plus
          |  Save Stock
        button.btn.secondary-btn(type="button" onclick="window.location.href='/store'")
          i.fa-solid.fa-rotate-left
          |  Cancel Form

  script.
    document.getElementById('stockForm').addEventListener('submit', function(event) {
      let isValid = true;
      
      //- 1. Remove previous client-side error messages and red borders
      document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
      document.querySelectorAll('.js-error-msg').forEach(el => el.remove());

      //- 2. Validate required fields
      const requiredFields = this.querySelectorAll('input[required], select[required]');
      
      requiredFields.forEach(field => {
        if (!field.value || field.value.trim() === "") {
          field.classList.add('is-invalid');
          
          //- Create the error message element
          const errorSpan = document.createElement('span');
          errorSpan.className = 'error-message js-error-msg'; //- Uses your existing CSS
          errorSpan.style.display = 'block';
          errorSpan.textContent = 'This field is required.';
          
          //- Insert the error span immediately after the input/select/parent
          if (field.classList.contains('phone-input')) {
             field.parentNode.parentNode.appendChild(errorSpan);
          } else {
             field.parentNode.appendChild(errorSpan);
          }
          
          isValid = false;
        }
      });

      if (!isValid) {
        event.preventDefault();
        //- Optional: Scroll to the first error
        document.querySelector('.is-invalid').scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });