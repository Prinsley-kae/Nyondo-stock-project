extends admin-layout

block content
  //- ================= FLASH MESSAGES =================
  if success_msg && success_msg.length > 0
    .alert.alert-success(style="background: #d4edda; color: #155724; padding: 15px; border-radius: 5px; margin-bottom: 20px;")
      = success_msg
      
  if error_msg && error_msg.length > 0
    .alert.alert-danger(style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px;")
      = error_msg

  //- ================= PAGE HEADER =================
  .page-header
    h2 Account Settings
    p Update your administrative profile information

  //- ================= PROFILE MAIN OVERVIEW =================
  .summary-section
    h3 Admin Profile Summary
    .summary-grid
      .summary-card
        .summary-card-header
          i.fa-solid.fa-user
          h4 Account Name
        p.font-semibold #{(user && user.fullname) ? user.fullname : 'System Administrator'}
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-envelope
          h4 Email Address
        p.font-semibold #{(user && user.email) ? user.email : 'admin@nyondo.com'}
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-shield-halved
          h4 System Role
        p.font-semibold.role-text-transform #{(user && user.role) ? user.role : 'Super Admin'}

  //- ================= UPDATE ACCOUNT FORM =================
  .form-section
    h3 Update Profile Information
    form#profileForm(method="POST" action="/admin/profile/update" novalidate)
      .form-grid
        .input-group
          label Full Name
          .icon-input-wrapper
            i.fa-solid.fa-user.input-icon
            input(type="text" name="name" value=(user && user.fullname) ? user.fullname : "" required placeholder="e.g. John Doe")

        .input-group
          label Email Address
          .icon-input-wrapper
            i.fa-solid.fa-envelope.input-icon
            input(type="email" name="email" value=(user && user.email) ? user.email : "" required placeholder="e.g. admin@nyondo.com")

      .form-actions-bar
        button.btn.primary-action-btn(type="submit")
          i.fa-solid.fa-floppy-disk
          | Save Profile Changes

  //- ================= STYLES & SCRIPTS =================
  style.
    .is-invalid { border: 2px solid #dc3545 !important; }

  script.
    //- 1. Auto-hide success message
    document.addEventListener('DOMContentLoaded', function() {
      const successAlert = document.querySelector('.alert-success');
      if (successAlert) {
        setTimeout(function() {
          successAlert.style.transition = "opacity 0.5s ease";
          successAlert.style.opacity = "0";
          setTimeout(function() { successAlert.style.display = "none"; }, 500);
        }, 5000);
      }
    });

    //- 2. Form Validation Logic
    function validateForm(formId) {
      document.getElementById(formId).addEventListener('submit', function(e) {
        let hasError = false;
        const inputs = this.querySelectorAll('input[required]');
        inputs.forEach(input => {
          if (!input.value.trim()) {
            input.classList.add('is-invalid');
            hasError = true;
          } else {
            input.classList.remove('is-invalid');
          }
        });
        if (hasError) {
          e.preventDefault();
          alert("Please fill in all required fields.");
        }
      });
    }

    validateForm('profileForm');

    //- Remove red border on typing
    document.addEventListener('input', function(e) {
      if (e.target.classList.contains('is-invalid')) {
        e.target.classList.remove('is-invalid');
      }
    });