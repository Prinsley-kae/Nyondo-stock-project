extends admin-layout

block content
  // ================= PAGE HEADER =================
  .page-header
    h2 Account Settings
    p Update your administrative profile information and security credentials

  // ================= PROFILE MAIN OVERVIEW =================
  .summary-section
    h3 Admin Profile Summary
    .summary-grid
      .summary-card
        .summary-card-header
          i.fa-solid.fa-user
          h4 Account Name
        p.font-semibold #{(user && user.name) ? user.name : 'System Administrator'}
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-envelope
          h4 Email Address
        p.font-semibold #{(user && user.email) ? user.email : 'admin@nyondo.com'}
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-shield-halved
          h4 System Role
        p.font-semibold.role-text-transform #{(user && user.role) ? user.role : 'Super Admin'}

  // ================= UPDATE ACCOUNT FORM =================
  .form-section
    h3 Update Profile Information
    
    form(method="POST" action="/admin/profile/update")
      .form-grid
        
        // ================= FULL NAME =================
        .input-group
          label Full Name
          .icon-input-wrapper
            i.fa-solid.fa-user.input-icon
            input(
              type="text"
              name="name"
              value=(user && user.name) ? user.name : ""
              required
              placeholder="e.g. John Doe"
            )

        // ================= EMAIL ADDRESS =================
        .input-group
          label Email Address
          .icon-input-wrapper
            i.fa-solid.fa-envelope.input-icon
            input(
              type="email"
              name="email"
              value=(user && user.email) ? user.email : ""
              required
              placeholder="e.g. admin@nyondo.com"
            )

      .form-actions-bar
        button.btn.primary-action-btn(type="submit")
          i.fa-solid.fa-floppy-disk
          | Save Profile Changes

  // ================= SECURITY/PASSWORD UPDATE =================
  .form-section(style="margin-top: 32px;")
    h3 Change Security Password
    
    form(method="POST" action="/admin/profile/update-password")
      .form-grid
        
        // ================= CURRENT PASSWORD =================
        .input-group
          label Current Password
          .icon-input-wrapper
            i.fa-solid.fa-lock.input-icon
            input(
              type="password"
              name="currentPassword"
              required
              placeholder="••••••••"
            )

        // ================= NEW PASSWORD =================
        .input-group
          label New Password
          .icon-input-wrapper
            i.fa-solid.fa-key.input-icon
            input(
              type="password"
              name="newPassword"
              required
              placeholder="Minimum 8 characters"
            )

      .form-actions-bar
        button.btn.primary-action-btn(type="submit")
          i.fa-solid.fa-shield-lock
          | Update Password