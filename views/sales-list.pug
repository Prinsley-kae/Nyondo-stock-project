extends sales-layout

block content

  //- ================= PAGE HEADER =================
  .page-header.flex-between

    div
      h2 Recent Sales Transactions
      p View and manage your daily sales records

    a.btn.secondary(href="/sales/add-sale")
      i.fa-solid.fa-plus
      |   New Sale


  //- ================= SALES TABLE =================
  .recent-section

    h3 Sales List

    .table-responsive

      table

        thead
          tr
            th No.
            th Date
            th Item Name
            th Customer Name
            th Delivery Method
            th Quantity
            th Selling Price (UGX)
            th Sub Total (UGX)
            th Transport Fee (UGX)
            th Final Total (UGX)
            th Actions

        tbody

          if sales && sales.length

            each sale, index in sales

              tr

                //- ================= NUMBER ==============
                td= index + 1

                //- ================= DATE =================
                td #{new Date(sale.date || sale.createdAt).toLocaleDateString()}

                //- ================= ITEM NAME =================
                td
                  if sale.items && sale.items.length
                    each entry in sale.items
                      if entry.item && entry.item.itemName
                        span.table-item-tag #{entry.item.itemName}
                        br
                      else
                        span.text-muted Deleted Item
                        br
                  else
                    span.text-muted No items

                //- ================= CUSTOMER INFO =================
                td
                  if sale.customerName
                    | #{sale.customerName}
                    br
                    small.text-muted #{sale.phoneNumber || 'No Phone'}
                  else
                    span.text-muted Walk-in

                //- ================= DELIVERY METHOD =================
                td(style="white-space: nowrap;")
                  if sale.deliveryMethod === 'self-pick' || !sale.distance || sale.distance === 0
                    span.badge.badge-info(style="background-color: #e3f2fd; color: #0d47a1; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; white-space: nowrap;") Self-Pick
                  else
                    span.badge.badge-success(style="background-color: #e8f5e9; color: #1b5e20; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; white-space: nowrap;") Delivery
                    br
                    small.text-muted #{sale.distance} KM

                //- ================= QUANTITY =================
                td
                  if sale.items && sale.items.length
                    each entry in sale.items
                      span #{entry.quantity}
                      br
                  else
                    span.text-muted -

                //- ================= SELLING PRICE =================
                td
                  if sale.items && sale.items.length
                    each entry in sale.items
                      span #{entry.unitPrice ? entry.unitPrice.toLocaleString() : 0}
                      br
                  else
                    span.text-muted -

                //- ================= TOTAL AMOUNT (SUBTOTAL) =================
                td #{sale.subtotal ? sale.subtotal.toLocaleString() : 0}

                //- ================= TRANSPORT FEE =================
                td #{sale.transportFee ? sale.transportFee.toLocaleString() : 0}

                //- ================= FINAL TOTAL =================
                td.font-semibold #{sale.finalTotal ? sale.finalTotal.toLocaleString() : 0}

                //- ================= ACTIONS =================
                td
                  .action-btns

                    //- ================= EDIT =================
                    a(
                      href=`/sales/add-sale/edit/${sale._id}`
                      title="Edit Sale"
                    )
                      i.fa-solid.fa-pen-to-square

                    //- ================= DELETE =================
                    a(
                      href=`/sales/add-sale/delete/${sale._id}`
                      onclick="return confirm('Delete this sale? Stock will be restored.')"
                      title="Delete Sale"
                    )
                      i.fa-solid.fa-trash

          else

            tr
              td(colspan="11") No sales found in the system.