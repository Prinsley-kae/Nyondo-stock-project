extends admin-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Admin Dashboard
    p System overview: sales, stock, suppliers, and credit status

  // ================= KPI CARDS =================
  .stats-grid

    .card
      i.fa-solid.fa-coins.icon-revenue
      .info
        h3 Sales Revenue
        p UGX #{stats && stats.salesRevenue ? stats.salesRevenue.toLocaleString() : 0}

    .card
      i.fa-solid.fa-boxes-stacked.icon-expenditure
      .info
        h3 Stock Expenditure
        p UGX #{stats && stats.inventoryValue ? stats.inventoryValue.toLocaleString() : 0}

    .card
      i.fa-solid.fa-truck-field.icon-suppliers
      .info
        h3 Suppliers
        p #{supplierCount || 0}

    .card
      i.fa-solid.fa-money-bill-trend-up.icon-credit
      .info
        h3 Outstanding Credit
        p UGX #{totalCredit ? totalCredit.toLocaleString() : 0}

  // ================= SYSTEM SUMMARY =================
  .summary-section
    h3 System Overview

    .summary-grid

      .summary-card
        .summary-card-header
          i.fa-solid.fa-chart-line
          h4 Sales Performance
        p Total transactions processed across all active hardware attendants.

      .summary-card
        .summary-card-header
          i.fa-solid.fa-warehouse
          h4 Inventory Status
        p Current operational material stock levels and item product availability.

      .summary-card
        .summary-card-header
          i.fa-solid.fa-handshake
          h4 Supplier Activity
        p Procurement credit updates, balance purchases, and milestone tracking.

  // ================= QUICK NAVIGATION =================
  .quick-actions
    h3 Quick Actions

    .action-buttons

      a.btn.action-btn(href="/admin/users")
        i.fa-solid.fa-users
        span Manage Users

      a.btn.action-btn(href="/admin/sales-report")
        i.fa-solid.fa-chart-line
        span Sales Report

      a.btn.action-btn(href="/admin/stock-report")
        i.fa-solid.fa-boxes-stacked
        span Stock Report

      a.btn.action-btn(href="/admin/credit-report")
        i.fa-solid.fa-money-bill
        span Credit Report