extends sales-layout

block content

  //- ================= PAGE HEADER =================
  .page-header
    h2 Sales Dashboard
    p Welcome back. Here is your sales summary.

  //- ================= STATS CARDS =================
  .stats-grid
    .card
      i.fa-solid.fa-cart-shopping
      .info
        h3 Today's Sales
        p #{stats && stats.todaySalesCount ? stats.todaySalesCount.toLocaleString() : 0}

    .card
      i.fa-solid.fa-money-bill-wave
      .info
        h3 Total Revenue
        p UGX #{stats && stats.totalRevenue ? stats.totalRevenue.toLocaleString() : 0}

    .card
      i.fa-solid.fa-receipt
      .info
        h3 Transactions
        p #{stats && stats.totalTransactions ? stats.totalTransactions.toLocaleString() : 0}

    .card
      i.fa-solid.fa-boxes-stacked
      .info
        h3 Active Products
        p #{stats && stats.totalStockItems ? stats.totalStockItems.toLocaleString() : 0}

  //- ================= QUICK ACTIONS =================
  .quick-actions
    h3 Quick Actions
    .action-buttons
      a.btn.secondary(href="/sales/add-sale")
        i.fa-solid.fa-plus
        |  Add Sale

      a.btn.secondary(href="/sales/sales-list")
        i.fa-solid.fa-receipt
        |  View Sales List

      a.btn.info(href="/sales/analytics" )
        i.fa-solid.fa-chart-line
        |  View Analytics

      a.btn.primary(href="/sales/report-form" )
        i.fa-solid.fa-file-invoice
        |  Generate Sales Report

      //- UPDATED: Now points to the Archive Page
      a.btn.secondary(href="/sales/reports/list" )
        i.fa-solid.fa-folder-open
        |  View Report Archive
        
      
  //- ================= RECENT SALES =================
  .recent-section
    h3 Recent Sales (Top 5)
    .table-responsive
      table
        thead
          tr
            th No
            th Date
            th Customer
            th Delivery
            th Products
            th Qty
            th Total
            th Transport
        tbody
          if recentSales && recentSales.length > 0
            each sale, index in recentSales
              tr
                td.font-semibold= index + 1
                td(style="white-space: nowrap;")= sale.date ? new Date(sale.date).toLocaleDateString('en-GB') : 'N/A'
                td
                  span.font-semibold= sale.customerName || 'Walk-in'
                  if sale.phoneNumber
                    br
                    small.timestamp-muted= sale.phoneNumber
                td(style="white-space: nowrap;")
                  if sale.deliveryMethod === 'self-pick' || !sale.distance || sale.distance === 0
                    span.badge.badge-info(style="background-color: #e3f2fd; color: #0d47a1; padding: 4px 8px; border-radius: 4px; font-size: 0.85em;") Self-Pick
                  else
                    span.badge.badge-success(style="background-color: #e8f5e9; color: #1b5e20; padding: 4px 8px; border-radius: 4px; font-size: 0.85em;") Delivery
                    br
                    small.timestamp-muted #{sale.distance} KM
                td
                  each entry in sale.items
                    div(style="white-space: nowrap;")= entry.item ? entry.item.itemName : 'Deleted'
                td
                  each entry in sale.items
                    div #{entry.quantity}
                td.font-semibold(style="white-space: nowrap;") UGX #{Number(sale.finalTotal || 0).toLocaleString()}
                td(style="white-space: nowrap;")= sale.transportFee > 0 ? 'UGX ' + sale.transportFee.toLocaleString() : 'Free'
          else
            tr: td(colspan="8" style="text-align: center; padding: 20px;") No sales recorded yet.

  //- ================= WEEKLY SUMMARY TABLE =================
  .recent-section(style="margin-top: 40px;")
    h3 Weekly Sales Performance (Last 7 Days)
    .table-responsive
      table
        thead
          tr
            th Period
            th Total Transactions
            th Total Revenue
        tbody
          if weeklyReport && weeklyReport.length > 0
            tr
              td Past 7 Days
              td= weeklyReport.length
              td.font-semibold UGX #{weeklyReport.reduce((sum, s) => sum + (s.finalTotal || 0), 0).toLocaleString()}
          else
            tr
              td(colspan="3" style="text-align: center; padding: 20px; color: #888;") No sales recorded in the last 7 days.


              //- ================= SUCCESS MODAL =================
  #successModal.modal-overlay
    .modal-content
      h2 CONGRATULATIONS!
      p You have successfully signed into the Nyondo Hardware system. Feel at home.

  script.
    document.addEventListener("DOMContentLoaded", function() {
      const urlParams = new URLSearchParams(window.location.search);
      const modal = document.getElementById('successModal');

      if (urlParams.get('success') === 'true' && modal) {
        modal.style.display = 'flex';

        setTimeout(() => {
          modal.style.display = 'none';

          //- Clean URL to prevent reappearance on refresh
          window.history.replaceState({}, document.title, window.location.pathname);
        }, 3000);
      }
    });