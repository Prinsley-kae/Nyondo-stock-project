extends admin-layout

block content
  // ================= PAGE HEADER =================
  .page-header
    h2 Transport Rules Management
    p Configure delivery charges and free transport conditions

  // ================= CURRENT RULES CARDS (Using Summary Grid) =================
  .summary-section
    h3 Current Transport Policy
    .summary-grid
      .summary-card
        .summary-card-header
          i.fa-solid.fa-location-dot
          h4 Free Delivery Radius
        p.font-semibold #{(rules && rules.freeRadius) ? rules.freeRadius : 10} KM
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-money-bill-wave
          h4 Min Order for Free Delivery
        - const currentMinOrder = (rules && rules.minOrder) ? rules.minOrder : 500000;
        p.font-semibold UGX #{Number(currentMinOrder).toLocaleString()}
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-truck-ramp-box
          h4 Standard Delivery Fee
        - const currentFee = (rules && rules.deliveryFee) ? rules.deliveryFee : 30000;
        p.font-semibold UGX #{Number(currentFee).toLocaleString()}

  // ================= UPDATE FORM =================
  .form-section
    h3 Update Transport Rules
    
    form(method="POST" action="/admin/transport-rules/update")
      //- Smart Grid For Scalable Multi-Column Inputs
      .form-grid
        
        // ================= FREE RADIUS =================
        .input-group
          label Free Delivery Radius (KM)
          .icon-input-wrapper
            i.fa-solid.fa-location-dot.input-icon
            input(
              type="number"
              name="freeRadius"
              min="0"
              value=(rules && rules.freeRadius) ? rules.freeRadius : ""
              required
              placeholder="e.g. 10"
            )

        // ================= MIN ORDER =================
        .input-group
          label Minimum Order for Free Delivery (UGX)
          .icon-input-wrapper
            i.fa-solid.fa-money-bill-wave.input-icon
            input(
              type="number"
              name="minOrder"
              min="0"
              value=(rules && rules.minOrder) ? rules.minOrder : ""
              required
              placeholder="e.g. 500000"
            )

        // ================= DELIVERY FEE =================
        .input-group
          label Standard Delivery Fee (UGX)
          .icon-input-wrapper
            i.fa-solid.fa-truck-ramp-box.input-icon
            input(
              type="number"
              name="deliveryFee"
              min="0"
              value=(rules && rules.deliveryFee) ? rules.deliveryFee : ""
              required
              placeholder="e.g. 30000"
            )

      // ================= FORM ACTIONS BAR =================
      .form-actions-bar
        button.btn.primary-action-btn(type="submit")
          i.fa-solid.fa-truck
          span Update Transport Rules

  // ================= INFO SECTION =================
  .form-section(style="margin-top: 32px;")
    h3 How Transport Works in NYONDO System
    ul(style="padding-left: 20px; color: var(--text-muted); display: flex; flex-direction: column; gap: 8px;")
      li Customers within the free radius **AND** order above the minimum qualify for free delivery.
      li Otherwise, the standard delivery fee is automatically applied.
      li Attendants must calculate transport during sales entry.
      li Managers and Admins can update these system rules at any given time.