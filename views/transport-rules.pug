extends admin-layout

block content
  //- ================= FLASH MESSAGES =================
  if success_msg && success_msg.length > 0
    .alert.alert-success(style="background: #d4edda; color: #155724; padding: 15px; border-radius: 5px; margin-bottom: 20px;")
      = success_msg
      
  if error_msg && error_msg.length > 0
    .alert.alert-danger(style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px;")
      = error_msg

  //- ================= PAGE HEADER =================
  .page-header
    h2 Transport Rules Management
    p Configure delivery charges and free transport conditions

  //- ================= CURRENT RULES CARDS =================
  .summary-section
    h3 Current Transport Policy
    .summary-grid
      .summary-card
        .summary-card-header
          i.fa-solid.fa-location-dot
          h4 Free Delivery Radius
        p.font-semibold #{(rules && rules.freeRadius) ? rules.freeRadius : 10} KM
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-money-bill-wave
          h4 Min Order for Free Delivery
        - const currentMinOrder = (rules && rules.minOrder) ? rules.minOrder : 500000;
        p.font-semibold UGX #{Number(currentMinOrder).toLocaleString()}
      
      .summary-card
        .summary-card-header
          i.fa-solid.fa-truck-ramp-box
          h4 Standard Delivery Fee
        - const currentFee = (rules && rules.deliveryFee) ? rules.deliveryFee : 30000;
        p.font-semibold UGX #{Number(currentFee).toLocaleString()}

  //- ================= UPDATE FORM =================
  .form-section
    h3 Update Transport Rules
    form#transportForm(method="POST" action="/admin/transport-rules/update" novalidate)
      .form-grid
        .input-group
          label Free Delivery Radius (KM)
          .icon-input-wrapper
            i.fa-solid.fa-location-dot.input-icon
            input(type="number" name="freeRadius" min="0" value=(rules ? rules.freeRadius : "") required)

        .input-group
          label Minimum Order for Free Delivery (UGX)
          .icon-input-wrapper
            i.fa-solid.fa-money-bill-wave.input-icon
            input(type="number" name="minOrder" min="0" value=(rules ? rules.minOrder : "") required)

        .input-group
          label Standard Delivery Fee (UGX)
          .icon-input-wrapper
            i.fa-solid.fa-truck-ramp-box.input-icon
            input(type="number" name="deliveryFee" min="0" value=(rules ? rules.deliveryFee : "") required)

      .form-actions-bar
        button.btn.primary-action-btn(type="submit")
          i.fa-solid.fa-truck
          span Update Transport Rules

  //- ================= STYLES & SCRIPTS =================
  style.
    .is-invalid { border: 2px solid #dc3545 !important; }

  script.
    //- 1. AUTO-HIDE SUCCESS MESSAGE
    document.addEventListener('DOMContentLoaded', function() {
      const successAlert = document.querySelector('.alert-success');
      if (successAlert) {
        setTimeout(function() {
          successAlert.style.transition = "opacity 0.5s ease";
          successAlert.style.opacity = "0";
          setTimeout(function() { successAlert.style.display = "none"; }, 500);
        }, 5000);
      }
    });

    //- 2. FORM VALIDATION
    document.getElementById('transportForm').addEventListener('submit', function(e) {
      let hasError = false;
      const inputs = this.querySelectorAll('input[required]');

      inputs.forEach(input => {
        if (!input.value.trim()) {
          input.classList.add('is-invalid');
          hasError = true;
        } else {
          input.classList.remove('is-invalid');
        }
      });

      if (hasError) {
        e.preventDefault();
        alert("Please fill in all required fields marked in red.");
      }
    });

    //- Clear red borders on input
    document.addEventListener('input', function(e) {
      if (e.target.classList.contains('is-invalid')) {
        e.target.classList.remove('is-invalid');
      }
    });