doctype html
html
  head
    title Report History
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="/css/stock.css")

  body
    .container
      .report-header
        h2 Generated Reports History
        a.btn.btn-secondary(href=dashboardUrl) ← Back to Dashboard

      table.table.table-bordered.table-hover
        thead.table-dark
          tr
            th No.
            th Report Title
            th Generated By
            th Date Generated
            th Actions

        tbody
          if reports && reports.length
            each report, i in reports
              tr
                td= i + 1
                td= report.title
                td= report.generatedBy || 'System'
                td= new Date(report.createdAt).toLocaleDateString('en-GB')
                td
                  .action-group
                    a.btn-icon.btn-view(
                      href=`/reports/${report.filename}`,
                      target="_blank",
                      title="View"
                    )
                      i.fa.fa-eye

                    a.btn-icon.btn-download(
                      href=`/reports/${report.filename}`,
                      download,
                      title="Download"
                    )
                      i.fa.fa-download

                    button.btn-icon.btn-print(
                      onclick=`window.open('/reports/${report.filename}').print()`,
                      title="Print"
                    )
                      i.fa.fa-print

                    button.btn-icon.btn-delete(
                      onclick=`deleteReport('${report._id}')`,
                      title="Delete"
                    )
                      i.fa.fa-trash

          else
            tr
              td(colspan="5" class="text-center") No reports found.

    script.
      function deleteReport(id) {
        if(confirm('Are you sure you want to delete this report?')) {
          fetch(`/store/reports/delete/${id}`, { method: 'DELETE' })
            .then(res => {
              if(res.ok) window.location.reload();
              else alert("Failed to delete report.");
            })
            .catch(err => console.error("Delete failed", err));
        }
      }