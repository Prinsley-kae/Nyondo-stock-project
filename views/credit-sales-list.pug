extends admin-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Customer Deposits
    p View and manage all customer deposit transactions

  // ================= TOP ACTION BAR =================
  .quick-actions
    .action-bar-split
      .search-box-wrapper
        i.fa-solid.fa-magnifying-glass.search-icon
        input#searchInput(
          type="text"
          placeholder="Search customer, phone, receipt or item..."
          onkeyup="executeTableFilter()"
        )

      .action-buttons
        button.btn.action-btn(type="button" onclick="window.print()")
          i.fa-solid.fa-print
          span Generate Report
        a.btn.action-btn.primary-action-btn(href="/admin/deposits")
          i.fa-solid.fa-plus
          span New Deposit

  // ================= DEPOSITS TABLE =================
  .recent-section
    h3 Registered System Deposits

    .table-responsive
      table#depositsTable
        thead
          tr
            th No.
            th Receipt ID
            th Customer Name
            th Contact
            th NIN Number
            th Item Name
            th Deposit (UGX)
            th Balance (UGX)
            th Profile
            th Handled By
            th Logged Date
            th Status
            th.center-text Actions

        tbody
          if deposits && deposits.length
            each deposit, i in deposits
              - const d = new Date(deposit.createdAt || deposit.date)
              tr
                td= i + 1
                
                td
                  span.receipt-hash-tag ##{deposit._id.toString().slice(-6).toUpperCase()}
                
                td.font-semibold= deposit.customerName || 'Walk-in'
                
                td= deposit.customerContact || 'N/A'
                
                td= deposit.nin || 'N/A'
                
                td
                  if deposit.item
                    | #{deposit.item.itemName || deposit.item}
                  else
                    span.text-muted-italic N/A
                
                td.font-semibold.text-revenue
                  | #{deposit.amountPaid ? deposit.amountPaid.toLocaleString() : 0}
                
                td(class=(deposit.balance > 0 ? "text-danger font-semibold" : ""))
                  | #{deposit.balance ? deposit.balance.toLocaleString() : 0}
                
                td.role-text-transform= deposit.paymentType || 'Credit'
                
                td
                  if deposit.admin
                    | #{deposit.admin.username || deposit.admin.fullname}
                  else
                    span.text-muted System
                
                td
                  span= d.toLocaleDateString()
                  br
                  small.timestamp-sub-text #{d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                
                td
                  if deposit.balance > 0
                    span.badge.status-disabled Pending
                  else
                    span.badge.status-active Cleared

                td
                  .table-actions-flex-wrapper
                    a.btn.action-btn.action-sub-btn(
                      href=`/admin/deposits/${deposit._id}`
                      title="View Deposit"
                    )
                      i.fa-solid.fa-eye

                    a.btn.action-btn.action-sub-btn(
                      href=`/admin/deposits/edit/${deposit._id}`
                      title="Edit Deposit"
                    )
                      i.fa-solid.fa-pen

                    form.inline-form(
                      action=`/admin/deposits/delete/${deposit._id}`
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this deposit?')"
                    )
                      button.btn.action-btn.action-sub-btn.delete-action-btn(
                        type="submit"
                        title="Delete Deposit"
                      )
                        i.fa-solid.fa-trash
          else
            tr
              td.table-fallback-row(colspan="13") No registered customer deposits found.