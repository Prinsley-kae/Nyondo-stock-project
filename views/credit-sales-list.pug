extends admin-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Customer Deposits
    p View and manage all customer deposit transactions

  // ================= TOP ACTION BAR =================
  .action-bar

    .search-box
      i.fa-solid.fa-magnifying-glass
      input#searchInput(
        type="text"
        placeholder="Search customer, phone, receipt..."
      )

    .action-buttons
      button.btn(type="button" onclick="window.print()")
        i.fa-solid.fa-print
        | Generate Report

      a.btn.btn-primary(href="/admin/deposits")
        i.fa-solid.fa-plus
        | New Deposit

  // ================= TABLE =================
  .table-container
    table.deposit-table

      thead
        tr
          th No.
          th Date
          th Receipt ID
          th Customer Name
          th Phone
          th NIN
          th Item
          th Deposit
          th Balance
          th Payment
          th Admin
          th Status
          th Actions

      tbody

        if deposits && deposits.length

          each deposit, i in deposits

            - const d = new Date(deposit.createdAt || deposit.date)

            tr

              // ================= NUMBER =================
              td= i + 1

              // ================= RECEIPT =================
              td
                span.receipt-id
                  | ##{deposit._id.toString().slice(-6)}

              // ================= CUSTOMER =================
              td= deposit.customerName || 'Walk-in'

              // ================= PHONE =================
              td= deposit.customerContact || 'N/A'

              // ================= NIN =================
              td= deposit.nin || 'N/A'

              // ================= ITEM =================
              td
                if deposit.item
                  | #{deposit.item.itemName || deposit.item}
                else
                  | N/A

              // ================= DEPOSIT =================
              td
                | UGX #{deposit.amountPaid ? deposit.amountPaid.toLocaleString() : 0}

              // ================= BALANCE =================
              td
                | UGX #{deposit.balance ? deposit.balance.toLocaleString() : 0}

              // ================= PAYMENT TYPE =================
              td= deposit.paymentType || 'Credit'

              // ================= ADMIN NAME =================
              td
                if deposit.admin
                  | #{deposit.admin.username || deposit.admin.fullname}
                else
                  | System

              // ================= DATE =================
              td
                | #{d.toLocaleDateString()}
                br
                small.text-muted #{d.toLocaleTimeString()}

              // ================= STATUS =================
              td
                if deposit.balance > 0
                  span.badge.out Pending
                else
                  span.badge.good Cleared

              // ================= ACTIONS =================
              td.actions

                a.icon-btn.view(
                  href=`/admin/deposits/${deposit._id}`
                  title="View Deposit"
                )
                  i.fa-solid.fa-eye

                a.icon-btn.edit(
                  href=`/admin/deposits/edit/${deposit._id}`
                  title="Edit Deposit"
                )
                  i.fa-solid.fa-pen

                form(
                  action=`/admin/deposits/delete/${deposit._id}`
                  method="POST"
                  style="display:inline;"
                )
                  button.icon-btn.delete(
                    type="submit"
                    onclick="return confirm('Are you sure you want to delete this deposit?')"
                    title="Delete Deposit"
                  )
                    i.fa-solid.fa-trash

        else

          tr
            td.text-center(colspan="13")
              | No customer deposits found