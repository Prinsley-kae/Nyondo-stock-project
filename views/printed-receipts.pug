extends sales-layout

block content

  //- ================= PAGE HEADER =================
  .page-header.flex-between

    div
      h2 Printed Receipts
      p View and manage your generated transaction receipts


  //- ================= FILTER / SEARCH BAR =================
  .filter-bar

    .search-wrapper
      i.fa-solid.fa-magnifying-glass.search-icon
      input#searchInput(
        type="text"
        placeholder="Search receipts by customer, item, or ID..."
      )

    button.btn.secondary(
      type="button"
      onclick="window.print()"
    )
      i.fa-solid.fa-print
      |  Print Page


  //- ================= TABLE SECTION =================
  .recent-section

    .table-responsive

      table

        thead
          tr
            th No.
            th Receipt ID
            th Date
            th Customer Name
            th Item Name
            th Quantity
            th Total (UGX)
            th Attendant
            th Actions

        tbody

          if sales && sales.length

            each sale, i in sales

              tr

                //- ================= NUMBER =================
                td= i + 1

                //- ================= RECEIPT ID =================
                td.font-mono
                  | #{sale._id.toString().slice(-6).toUpperCase()}

                //- ================= DATE =================
                td
                  | #{new Date(sale.date || sale.createdAt).toLocaleString()}

                //- ================= CUSTOMER =================
                td= sale.customerName

                //- ================= ITEMS COLUMN =================
                td
                  if sale.items && sale.items.length
                    each entry in sale.items
                      if entry.item && entry.item.itemName
                        span.table-item-tag
                          | #{entry.item.itemName}
                        br
                      else
                        span.text-muted
                          | Item no longer in stock
                        br
                  else
                    span.text-muted
                      | No items

                //- ================= QUANTITY COLUMN (FIXED) =================
                td
                  if sale.items && sale.items.length
                    each entry in sale.items
                      span(style="font-weight: 600; color: #475569;")
                        | #{entry.quantity}
                      br
                  else
                    span.text-muted
                      | -

                //- ================= TOTAL =================
                td.font-semibold
                  | #{sale.finalTotal ? sale.finalTotal.toLocaleString() : 0}

                //- ================= ATTENDANT =================
                td
                  | #{sale.attendant ? sale.attendant.fullname : 'N/A'}

                //- ================= ACTIONS =================
                td
                  .action-btns

                    //- ================= VIEW BUTTON =================
                    a(
                      href=`/sales/receipts/${sale._id}`
                      title="View Receipt"
                    )
                      i.fa-solid.fa-eye

                    //- ================= DELETE BUTTON =================
                    a(
                      href=`/sales/receipts/delete/${sale._id}`
                      title="Delete Receipt"
                      onclick="return confirm('Are you sure you want to delete this receipt?')"
                    )
                      i.fa-solid.fa-trash

          else

            tr
              td(colspan="9")
                | No receipts found


  //- ================= CLIENT FILTER LOGIC =================
  script.
    document
      .getElementById('searchInput')
      .addEventListener('keyup', function () {

        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll("table tbody tr");

        rows.forEach(row => {
          if (row.cells.length === 1) return;

          const match = row.innerText.toLowerCase().includes(value);
          row.style.display = match ? "" : "none";
        });
      });