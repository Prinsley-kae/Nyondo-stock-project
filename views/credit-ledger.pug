doctype html
html
  head
    title NyondoStock | Official Credit Report
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    style.
      @page { size: landscape; margin: 10mm; }
      body { font-size: 12px; }
      .table td, .table th { padding: 4px !important; vertical-align: middle; }
      .report-meta { margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 10px; }

  body
    .container-fluid.mt-3
      //- Report Header Metadata
      .report-meta.d-flex.justify-content-between
        div
          h3 NYONDO General Hardware LTD
          p Official Credit Ledger Report
        div.text-end
          p #[strong Generated on:] #{new Date().toLocaleDateString()}
          p #[strong Generated by:] #{adminName || 'Admin'}
      
      h2.mb-3 Outstanding Credit Ledger
      
      .table-responsive
        table.table.table-striped.table-hover.table-bordered
          thead.table-dark
            tr
              th No.
              th Customer
              th Items / Quantity
              th Contact
              th Delivery
              th Transport (UGX)
              th Paid (UGX)
              th Balance (UGX)
              th Sale Date
              th Days Due
              th Recorded By
          tbody
            each debtor, index in debtors
              tr
                td= index + 1
                td= debtor.customerName
                td
                  ul.list-unstyled.mb-0
                    each itemObj in debtor.items
                      if itemObj.item
                        li #{itemObj.item.itemName} (x#{itemObj.quantity})
                td= debtor.customerContact
                td= debtor.deliveryMethod
                td= debtor.transportFee.toLocaleString()
                td= debtor.amountPaid.toLocaleString()
                td.fw-bold= debtor.balance.toLocaleString()
                
                //- Corrected Date Rendering
                td
                  if debtor.date
                    = new Date(debtor.date).toLocaleDateString()
                  else
                    | N/A
                
                //- Corrected Days Due Calculation
                td
                  if debtor.date
                    - var diff = Math.floor((new Date() - new Date(debtor.date)) / (1000 * 60 * 60 * 24))
                    span(class=diff > 30 ? "text-danger fw-bold" : "") #{diff} days
                  else
                    | N/A
                
                td= debtor.adminName || (debtor.admin ? debtor.admin.fullname : 'System')