doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Forgot Password - NYONDO
    link(rel='stylesheet' href='https://-cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
    link(rel='stylesheet' href='/css/style.css')
    style.
      input.input-error {
        border: 2px solid #ff4d4d !important;
        background-color: #fff0f0 !important;
      }
  body
    .container-login
      h1 Reset Password
      p Enter your email to generate a recovery link.
      
      if error_msg && error_msg.length > 0
        .alert-danger(style="background: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 15px;")
          i.fa-solid.fa-circle-exclamation
          span= error_msg

      
      form(method='POST' action='/forgot-password' novalidate)
        .input-group
          label Email Address
          input(type='email' name='email' required placeholder='name@company.com')
        
        button.btn.primary(type='submit') Send Reset Link

      .auth-links
        p
          a(href='/login') Back to Login

    script.
      //- Logic for red borders on empty submit
      document.querySelector('form').addEventListener('submit', function(e) {
        const inputs = this.querySelectorAll('input');
        let hasError = false;
        inputs.forEach(input => {
          if (input.value.trim() === '') {
            input.classList.add('input-error');
            hasError = true;
          } else {
            input.classList.remove('input-error');
          }
        });
        if (hasError) {
          e.preventDefault();
          alert('Please enter your email address.');
        }
      });

      //- Remove error on typing
      document.querySelectorAll('input').forEach(input => {
        input.addEventListener('input', () => {
          if (input.value.trim() !== '') {
            input.classList.remove('input-error');
          }
        });
      });