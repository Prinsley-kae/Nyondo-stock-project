doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NYONDO Stock System
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
    link(href='https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/css/style.css')

  body
    .container
      img.logo(src='/images/logo.png' alt='NYONDO Logo')
      h1 NYONDO Smart Inventory System
      p Efficient inventory and sales management.

      .action-group
        a.btn.primary(href='/login')
          i.fa-solid.fa-right-to-bracket
          | Login to Dashboard

        a.btn.secondary(href='/signup')
          i.fa-solid.fa-user-plus
          | Request Account Access

      .footer
        p © 2026 NYONDO General Hardware LTD
        p Nansana, Uganda