doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Manager Panel - NYONDO System

    //- Fonts & Icons
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet")

    //- Main Module CSS
    link(rel="stylesheet" href="/css/stock.css")

  body

    // ================= WRAPPER =================
    .dashboard-wrapper

      // ================= SIDEBAR =================
      aside.sidebar

        .brand
          h2 NYONDO HARDWARE 
          p STORE MANAGER'S PANEL

        ul.nav-links

          // ================= DASHBOARD =================
          li(class=(currentPath === '/store' ? 'active' : ''))
            a(href="/store")
              i.fa-solid.fa-gauge
              span Dashboard

          // ================= STOCK MODULE =================
          li(class=(currentPath === '/store/inventory' ? 'active' : ''))
            a(href="/store/inventory")
              i.fa-solid.fa-boxes-stacked
              span Stock List

          // ================= LOGOUT =================
          li
            a(href="/")
              i.fa-solid.fa-right-from-bracket
              span Logout

      // ================= MAIN CONTENT =================
      main.main-content

        // ================= TOPBAR =================
        header.topbar

          .left
            h3 Store Manager Panel

          .right
            .user-info
              i.fa-solid.fa-user-tie
              span Store Manager

        // ================= PAGE CONTENT =================
        section.content
          block content