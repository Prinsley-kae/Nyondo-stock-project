extends stock-layout

block content
  // ================= PAGE HEADER =================
  .page-header
    h2 Inventory & Stock Analytics
    p Monitor current warehouse quantities and track sales performance in real-time

  // ================= FILTER + SEARCH BAR =================
  .quick-actions
    .filter-wrapper
      .input-group.search-group
        input#searchInput(type="text" placeholder="Search by Item, Batch ID, or Supplier...")
        i.fa-solid.fa-magnifying-glass.search-icon
      button.btn.primary-btn.report-btn(type="button" onclick="window.print()")
        i.fa-solid.fa-print
        |  Generate Report

  // ================= 1. CURRENT WAREHOUSE STOCK ============
  .recent-section
    h3 Current Warehouse Stock
    .table-responsive
      table#registryTable
        thead
          tr
            th No.
            th Batch ID
            th Date Received
            th Item Name
            th Original Qty
            th Buying Price
            th Selling Price
            th Actions
        tbody
          if stocks && stocks.length
            each stock, i in stocks
              tr
                td= i + 1
                td: span.batch-badge= stock.batchId || 'N/A'
                td= stock.createdAt ? new Date(stock.createdAt).toLocaleDateString('en-GB') : 'N/A'
                td.font-semibold= stock.itemName || 'N/A'
                td.font-semibold= stock.originalQuantity || 0
                td UGX #{Number(stock.buyingPrice || 0).toLocaleString()}
                td UGX #{Number(stock.sellingPrice || 0).toLocaleString()}
                td
                  .button-group.table-actions
                    a.btn.secondary-btn(href=`/store/receipts/intake/${stock._id}` title="View GRN")
                      i.fa-solid.fa-file-invoice
                    a.btn.secondary-btn(href=`/store/inventory/edit/${stock._id}` title="Edit Stock")
                      i.fa-solid.fa-pen
                    form(action=`/store/inventory/delete/${stock._id}` method="POST" style="display:inline")
                      button.btn.secondary-btn(type="submit" title="Delete Record" onclick="return confirm('Are you sure?')")
                        i.fa-solid.fa-trash(style="color: #dc2626;")
          else
            tr: td(colspan="8" style="text-align: center;") No records found.

  // ================= 2. SALES VARIANCE LEDGER ============
  .recent-section.credit-section-margin
    h3 Active Sales Variance Ledger
    .table-responsive
      table#varianceTable
        thead
          tr
            th No.
            th Batch ID
            th Item Name
            th Stock at Hand
            th Units Sold
            th Actions
        tbody
          if stocks && stocks.length
            - let counter = 1
            each stock in stocks
              - const unitsSold = (stock.originalQuantity || 0) - (stock.currentQuantity || 0)
              if unitsSold > 0
                tr
                  td= counter++
                  td: span.batch-badge= stock.batchId || 'N/A'
                  td.font-semibold= stock.itemName || 'N/A'
                  td.font-bold(style="color: #2563eb;")= stock.currentQuantity || 0
                  td.font-bold(style="color: #ff4757;")= unitsSold
                  td
                    form(action=`/store/inventory/delete/${stock._id}` method="POST" style="display:inline")
                      button.btn.danger-btn(type="submit" title="Delete Sale Record" onclick="return confirm('Delete this sale record?')")
                        i.fa-solid.fa-trash
            if counter === 1
              tr: td(colspan="6" style="text-align: center; color: #888;") No sales have been recorded yet.
          else
            tr: td(colspan="6" style="text-align: center;") No inventory data available.

  // ================= STYLES + SEARCH SCRIPT =================
  style.
    .batch-badge { background: #eef2ff; color: #4f46e5; padding: 4px 8px; border-radius: 6px; font-family: monospace; font-size: 0.8rem; }
    .danger-btn { background: #fee2e2; color: #dc2626; border: none; padding: 6px 10px; border-radius: 4px; cursor: pointer; }
    .table-actions { display: flex; gap: 5px; }
  
  script.
    document.getElementById('searchInput').addEventListener('keyup', function () {
      const value = this.value.toLowerCase();
      document.querySelectorAll("table tbody tr").forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
      });
    });