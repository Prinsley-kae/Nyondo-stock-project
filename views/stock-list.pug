extends stock-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Inventory & Supplier Credits
    p Manage stock and supplier credit in one place

  // ================= FILTER + REPORT BAR =================
  .quick-actions
    .filter-wrapper
      
      // Modern Filter Search Box
      .input-group.search-group
        input#searchInput(
          type="text"
          placeholder="Search stock or credit records..."
        )
        i.fa-solid.fa-magnifying-glass.search-icon

      // Action Controls
      button.btn.primary-btn.report-btn(type="button" onclick="window.print()")
        i.fa-solid.fa-print
        |  Generate Report

  // =========================================================
  // ==================== STOCK INVENTORY ====================
  // =========================================================
  .recent-section
    h3 Stock Inventory

    .table-responsive
      table
        thead
          tr
            th No.
            th Date Received
            th Item Name
            th Product Preview
            th Quantity
            th Buying Price
            th Selling Price
            th Total Value
            th Alert Status
            th Actions

        tbody
          if stocks && stocks.length
            each stock, i in stocks
              - const d = stock.createdAt || stock.deliveryDate ? new Date(stock.createdAt || stock.deliveryDate) : null

              tr
                td= i + 1
                td
                  if d
                    span.font-semibold #{d.toLocaleDateString()}
                    br
                    small.timestamp-muted #{d.toLocaleTimeString()}
                  else
                    | N/A
                
                td.font-semibold= stock.itemName || 'N/A'
                
                td
                  if stock.itemImage
                    img.product-preview-img(
                      src=`/uploads/${stock.itemImage}` 
                      alt=stock.itemName 
                    )
                  else
                    span.no-image-fallback No Image

                td= stock.quantity || 0
                td UGX #{Number(stock.buyingPrice || 0).toLocaleString()}
                td UGX #{Number(stock.sellingPrice || 0).toLocaleString()}
                td.font-semibold UGX #{Number(stock.totalValue || 0).toLocaleString()}
                
                td
                  if Number(stock.quantity) === 0
                    span.badge.out Out of stock
                  else if Number(stock.quantity) <= 50
                    span.badge.critical Low stock
                  else
                    span.badge.low In stock
                
                td
                  .button-group.table-actions
                    a.btn.secondary-btn.action-sub-btn(
                      href=`/store/inventory/edit/${stock._id}` 
                      title="Edit Item"
                    )
                      i.fa-solid.fa-pen
                    
                    form(action=`/store/inventory/delete/${stock._id}` method="POST" style="display:inline")
                      button.btn.secondary-btn.action-sub-btn.delete-action-btn(
                        type="submit" 
                        onclick="return confirm('Delete this stock item permanently?')"
                        title="Delete Record"
                      )
                        i.fa-solid.fa-trash
          else
            tr
              td.table-fallback-row(colspan="10") No stock items available in the system repository.

  // =========================================================
  // ================= SUPPLIER CREDIT MATRIX =================
  // =========================================================
  .recent-section.credit-section-margin
    h3 Supplier Credit Records

    .table-responsive
      table
        thead
          tr
            th No.
            th Issuance Date
            th Supplier Details
            th Contact
            th Item Procured
            th Amount Owed
            th Mode
            th Status
            th Actions

        tbody
          if credits && credits.length
            each credit, i in credits
              - const d = credit.deliveryDate || credit.createdAt ? new Date(credit.deliveryDate || credit.createdAt) : null

              tr
                td= i + 1
                td
                  if d
                    span.font-semibold #{d.toLocaleDateString()}
                    br
                    small.timestamp-muted #{d.toLocaleTimeString()}
                  else
                    | N/A
                
                td.font-semibold= credit.supplierName || 'N/A'
                td= credit.supplierContact || 'N/A'
                td= credit.itemName || 'N/A'
                td.font-semibold.debt-text UGX #{Number(credit.totalValue || 0).toLocaleString()}
                td.capitalize-text= credit.paymentMethod || 'credit'
                
                td
                  if credit.paymentMethod === 'credit'
                    span.badge.out Unpaid
                  else
                    span.badge.low Paid
                
                td
                  .button-group.table-actions
                    a.btn.secondary-btn.action-sub-btn(
                      href=`/store/inventory/edit/${credit._id}` 
                      title="Edit Credit"
                    )
                      i.fa-solid.fa-pen
                    
                    form(action=`/store/inventory/delete/${credit._id}` method="POST" style="display:inline")
                      button.btn.secondary-btn.action-sub-btn.delete-action-btn(
                        type="submit" 
                        onclick="return confirm('Delete this supplier record?')"
                        title="Delete Record"
                      )
                        i.fa-solid.fa-trash
          else
            tr
              td.table-fallback-row(colspan="9") No outstanding credit obligations logged.

  // ================= REAL-TIME FILTER ENGINE =================
  script.
    document.getElementById('searchInput').addEventListener('keyup', function () {
      const value = this.value.toLowerCase();
      
      document.querySelectorAll("table tbody tr").forEach(row => {
        if(row.cells.length > 1) {
          const textContent = row.innerText.toLowerCase();
          row.style.display = textContent.includes(value) ? "" : "none";
        }
      });
    });