doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Sales Analytics Report
    //- Icons & Fonts
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet")

    //- Main CSS
    link(rel="stylesheet" href="/css/sales.css")

    style.
      body { font-family: sans-serif; background: #f4f7f6; padding: 40px; display: flex; flex-direction: column; align-items: center; }
      .card { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 800px; }
      .back-btn { margin-bottom: 20px; text-decoration: none; color: #555; font-weight: bold; }
    
  body
    a.back-btn(href="javascript:history.back()") ← Back to Dashboard
    
    .card
      h2(style="margin-top:0;") Sales Performance Analytics
      p.text-muted Top 5 Best-Selling Items
      canvas#salesChart

    //- Include Chart.js from CDN
    script(src="https://cdn.jsdelivr.net/npm/chart.js")
    
    script.
      // Prepare the data from the server
      const topProducts = !{JSON.stringify(topProducts)};
      
      const labels = topProducts.map(p => p.productDetails[0]?.itemName || 'Unknown');
      const data = topProducts.map(p => p.totalQty);

      const ctx = document.getElementById('salesChart').getContext('2d');
      new Chart(ctx, {
          type: 'bar',
          data: {
              labels: labels,
              datasets: [{
                  label: 'Total Items Sold',
                  data: data,
                  backgroundColor: '#3498db',
                  borderRadius: 5
              }]
          },
          options: {
              responsive: true,
              scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
          }
      });