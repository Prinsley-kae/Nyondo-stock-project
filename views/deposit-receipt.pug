extends admin-layout

block content

  style.
    .receipt-table { width: 100% !important; table-layout: fixed !important; }
    .receipt-table td, .receipt-table th { padding: 20px 10px !important; text-align: left; }
    .col-no { width: 10% !important; text-align: center !important; }
    .col-item { width: 30% !important; }
    .col-price, .col-total { width: 20% !important; text-align: right !important; }
    .col-qty { width: 10% !important; text-align: center !important; }

  .receipt-container
    .receipt-box
      //- Header Section
      .receipt-header
        .receipt-logo-wrapper
          img(src="/images/logo.png" alt="Nyondo Hardware Logo" class="receipt-logo-img")
        h2 NYONDO HARDWARE LTD
        p.location Nansana, Uganda
        .receipt-title Deposit Credit Receipt
        if sale._id
          p.receipt-id-tag Ref No: ##{sale._id.toString().slice(-6).toUpperCase()}

      //- Customer Info
      .receipt-section
        h3.section-heading Customer Profiles
        .info-row
          strong Customer:
          span #{sale.customerName}
        .info-row
          strong Address:
          span #{sale.customerAddress}
        .info-row
          strong Contact:
          span #{sale.customerContact}
        .info-row
          strong National ID (NIN):
          span #{sale.nin || 'N/A'}

      hr.divider

      //- Order Details
      .receipt-section
        h3.section-heading Order Details
        table.receipt-table
          thead
            tr
              th.col-no No.
              th.col-item Item Name
              th.col-qty  Qty
              th.col-price Unit Price
              th.col-total Subtotal
          tbody
            if sale.items && sale.items.length > 0
              each entry, index in sale.items
                - const unitPrice = entry.item ? (entry.item.sellingPrice || 0) : 0
                - const subtotal = unitPrice * entry.quantity
                tr
                  td.col-no #{index + 1}
                  td.col-item #{entry.item ? entry.item.itemName : 'Unknown Item'}
                  td.col-qty #{entry.quantity}
                  td.col-price UGX #{unitPrice.toLocaleString()}
                  td.col-total UGX #{subtotal.toLocaleString()}
            else
              tr
                td(colspan="5" style="text-align: center; color: #888;") No items attached to this record.

        .info-row
          strong Profile Type:
          span.payment-profile-type #{sale.paymentType}

      hr.divider

      //- Logistics
      .receipt-section
        h3.section-heading Delivery & Logistics
        .info-row
          strong Transit Distance:
          span #{sale.distance || 0} Km
        .info-row
          strong Transport Fee:
          span.transit-fee-amt UGX #{sale.transportFee ? sale.transportFee.toLocaleString() : 0}

      hr.divider

      //- Financials
      .receipt-section.financials-block
        .info-row
          strong Total Value:
          span.total-amount UGX #{sale.totalAmount ? sale.totalAmount.toLocaleString() : 0}
        .info-row
          strong Amount Advanced:
          span.amount-paid UGX #{sale.amountPaid ? sale.amountPaid.toLocaleString() : 0}
        .info-row
          strong Outstanding Balance:
          - const remainingDebt = sale.balance !== undefined ? sale.balance : (sale.outstandingBalance || 0)
          span.remaining-balance UGX #{remainingDebt.toLocaleString()}

      hr.divider

      //- Footer
      .receipt-footer-meta
        .info-row.meta-row
          strong Issued By:
          span #{(sale.admin && sale.admin.fullname) || 'N/A'}
        .info-row.meta-row
          strong Date Issued:
          span #{new Date(sale.date || sale.createdAt || Date.now()).toLocaleString()}
        p.thank-you Thank you for doing business with us!

    //- Controls
    .receipt-actions-wrapper
      button.btn.btn-print(onclick="window.print()")
        i.fa-solid.fa-print
        span Print Receipt
      a.btn.btn-back(href="/admin/deposits")
        i.fa-solid.fa-arrow-left
        span Back to Ledger