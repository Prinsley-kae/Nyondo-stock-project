extends admin-layout

block content

  //- ================= TOP CONTROLS SECTION =================
  .page-header-container
    .page-header
      h2 User Management
      p Create and manage system users and their roles

    .quick-actions
      .action-buttons
        a.btn.action-btn.primary-action-btn(href="/admin/add-user")
          i.fa-solid.fa-user-plus
          span Add New User

  //- ================= USERS TABLE =================
  .recent-section
    h3 Active System Accounts

    .table-responsive
      table
        thead
          tr
            th No.
            th Username
            th Email Address
            th Phone Number
            th Account Role
            th Joined Date
            th Status
            th.center-text Actions

        tbody
          if users && users.length
            each user, i in users
              tr
                td= i + 1
                td.font-semibold= user.fullname || 'N/A'
                td= user.email
                td= user.phonenumber || 'N/A'
                td.role-text-transform= user.role
                
                //-- New Joined Date Column
                td= user.createdAt ? user.createdAt.toLocaleDateString() : 'N/A'
                
                //-- Dynamic Status Display
                td
                  if user.isActive
                    span.badge.status-active Active
                  else
                    span.badge.status-disabled Disabled

                td
                  .button-group.table-actions-center
                    a.btn.action-btn.action-sub-btn(
                      href=`/admin/users/edit/${user._id}`
                      title="Edit User"
                    )
                      i.fa-solid.fa-pen

                    a.btn.action-btn.action-sub-btn.delete-action-btn(
                      href=`/admin/users/delete/${user._id}`
                      title="Delete User"
                      onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')"
                    )
                      i.fa-solid.fa-trash
          else
            tr
              td.table-fallback-row(colspan="8") No authorized system user accounts found in the directory.