extends admin-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 User Management
    p Create and manage system users and their roles

  // ================= ACTION BAR =================
  .action-bar
    a.btn(href="/admin/add-user")
      i.fa-solid.fa-user-plus
      |  Add New User

  // ================= USERS TABLE =================
  .table-section
    .table-container

      table
        thead
          tr
            th No.
            th Username
            th Email
            th Phone Number
            th Role
            th Status
            th Actions

        tbody
          if users && users.length

            each user, i in users
              tr

                // ================= NUMBER =================
                td= i + 1

                // ================= USERNAME =================
                td= user.username || 'N/A'

                // ================= EMAIL =================
                td= user.email

                // ================= PHONE =================
                td= user.phoneNumber || user.phonenumber || 'N/A'

                // ================= ROLE =================
                td= user.role

                // ================= STATUS =================
                td
                  if user.isActive
                    span.badge.good Active
                  else
                    span.badge.low Disabled

                // ================= ACTIONS =================
                td.actions

                  a.icon-btn.edit(
                    href=`/admin/users/edit/${user._id}`
                    title="Edit User"
                  )
                    i.fa-solid.fa-pen

                  a.icon-btn.delete(
                    href=`/admin/users/delete/${user._id}`
                    title="Delete User"
                    onclick="return confirm('⚠️ Are you sure you want to delete this user? This action cannot be undone.')"
                  )
                    i.fa-solid.fa-trash

          else
            tr
              td(colspan="7") No users found

  // ================= DELETE SCRIPT =================
  script.
    function confirmDelete() {
      return confirm("⚠️ Are you sure you want to delete this user? This action cannot be undone.");
    }