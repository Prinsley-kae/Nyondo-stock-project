extends sales-layout

block content

  //- ================= HEADER =================
  .page-header
    h2 Sales Receipts
    p View and manage completed sales transactions

  //- ================= RECEIPTS TABLE =================
  .table-container

    table
      thead
        tr
          th Receipt #
          th Customer
          th Product
          th Qty
          th Total (UGX)
          th Transport
          th Final Total
          th Date
          th Action

      tbody
        if sales && sales.length
          each sale in sales
            tr
              //- Receipt short ID
              td= sale._id.toString().slice(-6)

              //- Customer
              td
                if sale.customerName
                  | #{sale.customerName}
                else
                  span.text-muted Walk-in

              //- Product (from populated Stock)
              td
                if sale.itemName && sale.itemName.itemName
                  | #{sale.itemName.itemName}
                else
                  span.text-muted Deleted Item

              //- Quantity
              td= sale.quantity

              //- Total
              td UGX #{sale.total ? sale.total.toLocaleString() : 0}

              //- Transport fee
              td UGX #{sale.transportFee ? sale.transportFee.toLocaleString() : 0}

              //- Final total
              td UGX #{sale.finalTotal ? sale.finalTotal.toLocaleString() : 0}

              //- Date (your model uses "date", not createdAt)
              td= new Date(sale.date).toDateString()

              //- Action
              td
                a.btn.small(href=`/sales/receipt/${sale._id}`)
                  |  View
        else
          tr
            td(colspan="9") No sales recorded yet