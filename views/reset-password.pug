doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Reset Password - NYONDO
    link(rel='stylesheet' href='https://-cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
    link(rel='stylesheet' href='/css/style.css')
    style.
      input.input-error {
        border: 2px solid #ff4d4d !important;
        background-color: #fff0f0 !important;
      }
      .toggle-password { cursor: pointer; position: absolute; right: 10px; top: 12px; }
  body
    .container-login
      h1 Set New Password
      p Please enter your new secure password below.
      
      if error_msg && error_msg.length > 0
        .alert-danger(style="background: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 15px;")
          i.fa-solid.fa-circle-exclamation
          span= error_msg

      form(method='POST' action=`/reset-password/${token}` novalidate)
        .input-group
          label New Password
          .password-wrapper
            input#newPassword(type='password' name='password' required placeholder='••••••••')
            span.toggle-password(onclick="togglePassword('newPassword', this)")
              i.fa-solid.fa-eye
        
        .input-group
          label Confirm New Password
          .password-wrapper
            input#confirmPassword(type='password' name='confirmPassword' required placeholder='••••••••')
            span.toggle-password(onclick="togglePassword('confirmPassword', this)")
              i.fa-solid.fa-eye
        
        button.btn.primary(type='submit') Update Password

    script.
      //- Password Visibility Toggle
      function togglePassword(id, el) {
        const input = document.getElementById(id);
        const icon = el.querySelector('i');
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
      }

      //- Validation logic for red borders
      document.querySelector('form').addEventListener('submit', function(e) {
        const inputs = this.querySelectorAll('input');
        let hasError = false;
        inputs.forEach(input => {
          if (input.value.trim() === '') {
            input.classList.add('input-error');
            hasError = true;
          } else {
            input.classList.remove('input-error');
          }
        });
        if (hasError) {
          e.preventDefault();
          alert('Please fill in all fields.');
        }
      });