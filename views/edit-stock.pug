extends stock-layout

block content
  link(rel="stylesheet", href="/css/stock-form.css")

  //- ================= STYLES =================
  style.
    .is-invalid { border: 2px solid red !important; }
    .error-text { color: red; font-size: 12px; display: block; margin-top: 4px; }

  //-- Display global error message if it exists
  if error_msg && error_msg.length > 0
    .alert.alert-danger(style="padding: 15px; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; margin-bottom: 20px; border-radius: 4px;")
      = error_msg

  .page-header
    h2 Edit Stock Item
    p.subtitle Update product details, pricing, and quantity profiles

  .recent-section
    h3 Modify Product & Supplier Details

    form#stockForm.form-section(
      method="POST" 
      action=`/store/inventory/edit/${stock._id}` 
      enctype="multipart/form-data"
      novalidate
    )
      .form-grid
        mixin errorSpan(id)
          if errors && errors[id]
            span(id=`error-${id}` class="error-text")= errors[id].msg

        //- ========= ITEM NAME =========
        .input-group
          label(for="itemName") Item Name
          select#itemName(name="itemName" class=(errors && errors.itemName ? 'is-invalid' : '') required)
            option(value="" disabled) -- Select Item --
            each item in ["Cement iiN", "Cement iiiN", "Iron Sheets", "Nails inc 1", "Nails inc 3", "Nails inc 4", "Nails inc 5", "Iron bars 10mm", "Iron bars 12mm", "Iron bars 16mm", "Gauges", "Wire mesh", "Wheel barrows", "High tensile barbed wire", "Low tensile barbed wire"]
              option(value=item selected=( (formData ? formData.itemName : stock.itemName) === item ))= item
          +errorSpan('itemName')

        //- ========= QUANTITIES =========
        .input-group
          label(for="originalQuantity") Quantity Received
          input#originalQuantity(type="number" name="originalQuantity" class=(errors && errors.originalQuantity ? 'is-invalid' : '') value=(formData ? formData.originalQuantity : (stock.originalQuantity || stock.quantity)) min="1" required)
          +errorSpan('originalQuantity')

        .input-group
          label(for="currentQuantity") Current Stock at Hand
          input#currentQuantity(type="number" name="currentQuantity" class=(errors && errors.currentQuantity ? 'is-invalid' : '') value=(formData ? formData.currentQuantity : (stock.currentQuantity !== undefined ? stock.currentQuantity : stock.quantity)) min="0" required)
          +errorSpan('currentQuantity')

        //- ========= PRICING =========
        .input-group
          label(for="buyingPrice") Buying Price (UGX)
          input#buyingPrice(type="number" name="buyingPrice" class=(errors && errors.buyingPrice ? 'is-invalid' : '') value=(formData ? formData.buyingPrice : stock.buyingPrice) min="1" required)
          +errorSpan('buyingPrice')

        .input-group
          label(for="sellingPrice") Selling Price (UGX)
          input#sellingPrice(type="number" name="sellingPrice" class=(errors && errors.sellingPrice ? 'is-invalid' : '') value=(formData ? formData.sellingPrice : stock.sellingPrice) min="1" required)
          +errorSpan('sellingPrice')

        //- ========= SUPPLIER & COMPANY =========
        .input-group
          label(for="supplierName") Supplier Agent Name
          input#supplierName(type="text" name="supplierName" class=(errors && errors.supplierName ? 'is-invalid' : '') value=(formData ? formData.supplierName : stock.supplierName) required)
          +errorSpan('supplierName')

        .input-group
          label(for="companyName") Company / Factory Name
          input#companyName(type="text" name="companyName" class=(errors && errors.companyName ? 'is-invalid' : '') value=(formData ? formData.companyName : stock.companyName) required)
          +errorSpan('companyName')

        //- ========= CONTACT =========
        .input-group
          label(for="supplierContact") Supplier Contact
          .phone-input(style="display: flex; align-items: center; border: 1px solid #ccc; padding: 5px; border-radius: 4px;" class=(errors && errors.supplierContact ? 'is-invalid' : ''))
            span.phone-prefix(style="padding-right: 5px; color: #666;") +256
            input#supplierContact(type="text" name="supplierContact" value=(formData ? formData.supplierContact : (stock.supplierContact ? stock.supplierContact.replace('+256', '') : '')) maxlength="9" oninput="this.value = this.value.replace(/[^0-9]/g, '');" style="border: none; outline: none; width: 100%;" required)
          +errorSpan('supplierContact')

        //- ========= PAYMENT METHOD =========
        .input-group
          label(for="paymentMethod") Payment Method
          select#paymentMethod(name="paymentMethod" required)
            option(value="cash_at_hand" selected=( (formData ? formData.paymentMethod : stock.paymentMethod) === 'cash_at_hand' || (formData ? formData.paymentMethod : stock.paymentMethod) === 'cash')) Cash at hand
            option(value="credit" selected=((formData ? formData.paymentMethod : stock.paymentMethod) === 'credit')) Credit

        //- ========= IMAGE =========
        .input-group
          label(for="itemImage") Update Item Image
          input#itemImage(type="file" name="itemImage" accept="image/*")

        if stock.itemImage
          .input-group
            label Current Document Image
            .image-preview-wrapper
              img(src=`/uploads/${stock.itemImage}` width="85" alt=stock.itemName)

      hr.form-divider

      .button-group
        button.btn.primary-btn(type="submit")
          i.fa-solid.fa-floppy-disk
          |  Save Stock Changes
        button.btn.secondary-btn(type="button" onclick="window.location.href='/store/inventory'")
          i.fa-solid.fa-xmark
          |  Cancel Modification

  script.
      document.getElementById('stockForm').addEventListener('invalid', function(event) {
        const target = event.target;
        //- Add the class        
        target.classList.add('is-invalid');
        
        //- Check if an error message already exists
        let errorSpan = target.parentNode.querySelector('.error-text');
        
        if (!errorSpan) {
          errorSpan = document.createElement('span');
          errorSpan.className = 'error-text';
          errorSpan.textContent = 'This field is required';
          target.parentNode.appendChild(errorSpan);
        }
      }, true);

      document.getElementById('stockForm').addEventListener('input', function(event) {
        const target = event.target;
        if (target.classList.contains('is-invalid')) {
          target.classList.remove('is-invalid');
          const errorSpan = target.parentNode.querySelector('.error-text');
          if (errorSpan) {
            errorSpan.remove();
          }
        }
      }, true);