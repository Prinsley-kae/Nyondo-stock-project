extends stock-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Edit Stock Item
    p Update product details, pricing, and quantity

  // ================= EDIT FORM =================
  .form-container

    form(method="POST" action=`/store/inventory/edit/${stock._id}` enctype="multipart/form-data")

      .form-grid

        // ================= PRODUCT DROPDOWN =================
        .form-group
          label Select Existing Item

          select(name="itemName" required)
            option(value="") -- Select Item --

            each item in items
              option(
                value=item.itemName
                selected=(item.itemName == stock.itemName)
              )
                | #{item.itemName} - #{item.quantity} (#{item.sellingPrice} UGX)

        // ================= QUANTITY =================
        .form-group
          label Quantity

          input(
            type="number"
            name="quantity"
            min="0"
            value=stock.quantity
            required
          )

        // ================= BUYING PRICE =================
        .form-group
          label Buying Price (UGX)

          input(
            type="number"
            name="buyingPrice"
            min="0"
            value=stock.buyingPrice
            required
          )

        // ================= SELLING PRICE =================
        .form-group
          label Selling Price (UGX)

          input(
            type="number"
            name="sellingPrice"
            min="0"
            value=stock.sellingPrice
            required
          )

        // ================= SUPPLIER =================
        .form-group
          label Supplier Name

          input(
            type="text"
            name="supplier"
            value=stock.supplierName
          )

        .form-group
          label Supplier Contact

          .phone-input
            span.phone-prefix +256
            input(
              type="text"
              name="supplierContact"
              value=stock.supplierContact
            )

        // ================= PAYMENT METHOD =================
        .form-group
          label(for="paymentMethod") Payment Method

          select#paymentMethod(name="paymentMethod" required)
            option(value="Credit") Credit
            option(value="Cash_at_hand") Cash at hand

        // ================= ITEM IMAGE =================
        .form-group
          label(for="itemImage") Item Image

          input#itemImage(
            type="file"
            name="itemImage"
          )

        // ================= CURRENT IMAGE PREVIEW =================
        if stock.itemImage
          .form-group
            img(src=`/uploads/${stock.itemImage}` width="100")

      // ================= SUBMIT =================
      .form-actions
        button.btn(type="submit")
          i.fa-solid.fa-floppy-disk
          | Update Stock