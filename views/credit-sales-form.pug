extends admin-layout

block content
  .ledger-container
    //- ================= PAGE HEADER =================
    .ledger-header
      .header-badge-icon
        i.fa-solid.fa-file-invoice-dollar
      .header-titles
        h2 Credit Sales Ledger
        p Register customer purchases on credit, calculate logistics, and log down payments

    //- ================= FORM CONTAINER =================
    .ledger-card
      h3 Credit Agreement & Transaction Details

      //-- ================= FLASH ALERTS FEEDBACK LAYER =================
      if messages && messages.error_msg && messages.error_msg.length > 0
        .alert-box.alert-danger(style="background-color: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #f5c6cb; display: flex; align-items: center; gap: 10px;")
          i.fa-solid.fa-triangle-exclamation
          span= messages.error_msg

      if messages && messages.success_msg && messages.success_msg.length > 0
        .alert-box.alert-success(style="background-color: #d4edda; color: #155724; padding: 12px; border-radius: 6px; margin-bottom: 20px; border: 1px solid #c3e6cb; display: flex; align-items: center; gap: 10px;")
          i.fa-solid.fa-circle-check
          span= messages.success_msg

      //- Added novalidate to allow our custom JS validation
      form(method="POST" action="/admin/deposits" novalidate)
        //- ================= CUSTOMER DETAILS =================
        .section-title-wrapper
          i.fa-solid.fa-id-badge
          span Customer Profile Information

        .form-grid
          //- CUSTOMER NAME
          .input-group
            label Customer Name
            .icon-input-wrapper
              i.fa-solid.fa-user.input-icon
              input.validate-me(
                type="text"
                name="customerName"
                placeholder="Enter full name"
                value=(oldData ? oldData.customerName : '')
                class=(errors && errors.customerName ? 'is-invalid' : '')
                required
              )
            if errors && errors.customerName
              span.error-text(style="color: #dc3545; font-size: 0.8em; margin-top: 4px; display: block;")= errors.customerName.msg

          //- CUSTOMER ADDRESS
          .input-group
            label Customer Address / Location
            .icon-input-wrapper
              i.fa-solid.fa-location-dot.input-icon
              input.validate-me(
                type="text"
                name="customerAddress"
                placeholder="Town / Village / Zone"
                value=(oldData ? oldData.customerAddress : '')
                class=(errors && errors.customerAddress ? 'is-invalid' : '')
                required
              )
            if errors && errors.customerAddress
              span.error-text(style="color: #dc3545; font-size: 0.8em; margin-top: 4px; display: block;")= errors.customerAddress.msg

          //- CUSTOMER CONTACT
          .input-group
            label Customer Contact
            .icon-input-wrapper
              i.fa-solid.fa-phone.input-icon
              input.validate-me(
                type="tel"
                name="customerContact"
                id="customerPhoneInput"
                value=(oldData && oldData.customerContact ? oldData.customerContact : "+256")
                maxlength="13"
                pattern="^\\+256\\d{9}$"
                title="Phone number must start with +256 followed by exactly 9 digits"
                class=(errors && errors.customerContact ? 'is-invalid' : '')
                required
              )
            if errors && errors.customerContact
              span.error-text(style="color: #dc3545; font-size: 0.8em; margin-top: 4px; display: block;")= errors.customerContact.msg

          //- NIN NUMBER
          .input-group
            label NIN Number (National ID)
            .icon-input-wrapper
              i.fa-solid.fa-id-card.input-icon
              input.validate-me(
                type="text"
                name="nin"
                placeholder="Enter National ID Number"
                value=(oldData ? oldData.nin : '')
                class=(errors && errors.nin ? 'is-invalid' : '')
                required
              )
            if errors && errors.nin
              span.error-text(style="color: #dc3545; font-size: 0.8em; margin-top: 4px; display: block;")= errors.nin.msg

        hr.form-divider

        //- ================= ITEMS SECTION =================
        .items-management-section
          .section-title-wrapper
            i.fa-solid.fa-boxes-stacked
            span Materials & Hardware Items Ordered

          if errors && errors.items
            .alert-box.alert-danger(style="background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 10px; border-radius: 4px; border: 1px solid #f5c6cb;")= errors.items.msg

          .items-table-container
            table#itemsTable
              thead
                tr
                  th(style="width: 42%;") Product / Inventory Material
                  th(style="width: 16%; text-align: right;") Unit Price (UGX)
                  th(style="width: 14%;") Quantity
                  th(style="width: 18%; text-align: right;") Total Amount (UGX)
                  th(style="width: 10%; text-align: center;") Action
              tbody
                tr.item-row
                  td
                    .icon-input-wrapper
                      i.fa-solid.fa-layer-group.input-icon
                      select.item-select.validate-me(
                        name="items[0][itemId]"
                        required
                        onchange="calculateRowTotals(this)"
                      )
                        option(value="" disabled selected data-price="0") Choose stock item...
                        if items && items.length > 0
                          each item in items
                            option(
                              value=item._id
                              data-price=item.sellingPrice
                            )
                              | #{item.itemName} - #{item.sellingPrice.toLocaleString()} UGX (Stock: #{item.currentQuantity})
                  td
                    input.form-control-static.unit-price-display(type="text" value="0" readonly)
                  td
                    .icon-input-wrapper
                      i.fa-solid.fa-arrow-up-9-1.input-icon
                      input.item-quantity.validate-me(
                        type="number"
                        name="items[0][quantity]"
                        min="1"
                        placeholder="Qty"
                        required
                        oninput="calculateRowTotals(this)"
                      )
                  td
                    input.form-control-static.total-price-display(type="text" value="0" readonly)
                  td(style="text-align: center;")
                    button.btn-remove-row(type="button" onclick="confirmAndRemove(this)")
                      i.fa-solid.fa-trash-can

          button#btnAddRow.btn-secondary-action(type="button")
            i.fa-solid.fa-plus
            span Append Additional Item

        hr.form-divider

        //- ================= PAYMENT & DELIVERY =================
        .section-title-wrapper
          i.fa-solid.fa-wallet
          span Logistics & Settlement Processing

        .form-grid
          .input-group
            label Delivery / Fulfillment Method
            .icon-input-wrapper
              i.fa-solid.fa-truck.input-icon
              select(
                name="deliveryMethod"
                id="deliveryMethodSelect"
                required
                onchange="toggleDeliveryFields()"
              )
                option(
                  value="delivery"
                  selected=(oldData ? oldData.deliveryMethod === 'delivery' : true)
                ) Store Delivery
                option(
                  value="self-pick"
                  selected=(oldData ? oldData.deliveryMethod === 'self-pick' : false)
                ) Self-Pick

          .input-group#distanceInputGroup
            label Transit Distance (Km)
            .icon-input-wrapper
              i.fa-solid.fa-route.input-icon
              input.validate-me(
                type="number"
                name="distance"
                id="distanceInput"
                min="0"
                step="0.1"
                value=(oldData ? oldData.distance : "0")
                class=(errors && errors.distance ? 'is-invalid' : '')
                required
              )

          .input-group
            label Credit Settlement Profile
            .icon-input-wrapper
              i.fa-solid.fa-handshake.input-icon
              select(
                name="paymentType"
                id="paymentTypeSelect"
                required
                onchange="handlePaymentTypeChange()"
              )
                option(
                  value="credit"
                  selected=(oldData ? oldData.paymentType === 'credit' : true)
                ) Full Credit
                option(
                  value="partial"
                  selected=(oldData ? oldData.paymentType === 'partial' : false)
                ) Partial Payment

          .input-group
            label Amount Advanced / Paid (UGX)
            .icon-input-wrapper
              i.fa-solid.fa-money-bill-wave.input-icon
              input.validate-me(
                type="number"
                name="amountPaid"
                id="amountPaidInput"
                value=(oldData ? oldData.amountPaid : "0")
                min="0"
                class=(errors && errors.amountPaid ? 'is-invalid' : '')
              )

          .input-group.input-group-full
            label Terms & Operational Notes
            textarea.form-textarea.validate-me(name="notes" required)= (oldData ? oldData.notes : '')

        .form-actions-bar
          a.action-btn.cancel-btn(href="/admin") Cancel
          button.action-btn.primary-action-btn(type="submit")
            i.fa-solid.fa-credit-card
            span Save Credit Sale

      style.
        .is-invalid {
          border: 2px solid #dc3545 !important;
        }

      script.
        let rowCounter = 1;

        function calculateRowTotals(el) {
          const row = el.closest('.item-row');
          const select = row.querySelector('.item-select');
          const qty = row.querySelector('.item-quantity').value || 0;
          const price = select.options[select.selectedIndex].getAttribute('data-price') || 0;

          row.querySelector('.unit-price-display').value = price;
          row.querySelector('.total-price-display').value = (price * qty);
        }

        document.getElementById('btnAddRow').addEventListener('click', function() {
          const tbody = document.querySelector('#itemsTable tbody');
          const newRow = document.createElement('tr');
          newRow.className = 'item-row';
          
          newRow.innerHTML = `
            <td>
              <select name="items[${rowCounter}][itemId]" class="item-select" onchange="calculateRowTotals(this)">
                ${document.querySelector('.item-select').innerHTML}
              </select>
            </td>
            <td><input type="text" class="unit-price-display" value="0" readonly /></td>
            <td>
              <input type="number" name="items[${rowCounter}][quantity]" class="item-quantity" min="1" placeholder="Qty" oninput="calculateRowTotals(this)" />
            </td>
            <td><input type="text" class="total-price-display" value="0" readonly /></td>
            <td style="text-align: center;">
              <button class="btn-remove-row" type="button" onclick="removeRow(this)">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </td>
          `;
          
          tbody.appendChild(newRow);
          rowCounter++;
        });

        function removeRow(btn) { btn.closest('.item-row').remove(); }

        function handlePaymentTypeChange() {
          const type = document.getElementById('paymentTypeSelect').value;
          const amountInput = document.getElementById('amountPaidInput');
          amountInput.readOnly = (type === 'credit');
          if (type === 'credit') amountInput.value = "0";
        }

        document.querySelector('form').addEventListener('submit', function(e) {
          let hasError = false;
          const allInputs = this.querySelectorAll('input[required], select[required], textarea[required]');

          allInputs.forEach(field => {
            if (field.value.trim() === "") {
              field.classList.add('is-invalid');
              hasError = true;
            } else {
              field.classList.remove('is-invalid');
            }
          });

          if (hasError) {
            e.preventDefault();
            alert("Please fill in all required fields marked in red.");
          }
        });

        document.addEventListener('input', function(e) {
          if (e.target.hasAttribute('required')) {
            e.target.classList.remove('is-invalid');
          }
        });