extends admin-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Credit Sales
    p Register customer purchases on credit

  // ================= FORM =================
  .form-container

    form(method="POST" action="/sales/add-credit")

      .form-grid

        // ================= CUSTOMER NAME =================
        .form-group
          label(for="customerName") Customer Name
          input#customerName(
            type="text"
            name="customerName"
          )

          // ================= CUSTOMER ADDRESS =================
        .form-group
          label(for="customerAddress") Customer Address
          input#customerAddress(
            type="text"
            name="customerAddress"
          )

        // ================= PHONE =================
        .form-group
          label(for="phoneNumber") Customer Contact
          input#phoneNumber(
            type="number"
            name="customerContact"
          )

          // ================= NIN =================
        .form-group
          label(for="nin") NIN Number
          input#nin(
            type="text"
            name="nin"
          )

        // ================= ITEM =================
        .form-group
          label(for="itemId") Select Item

          select#itemId(name="itemId" required)
            option(value="" disabled selected) -- Select Product --
            each item in items
              option(value=item._id)
                | #{item.itemName} (Stock: #{item.quantity})

        // ================= QUANTITY =================
        .form-group
          label(for="quantity") Quantity
          input#quantity(
            type="number"
            name="quantity"
          )

        // ================= PAYMENT TYPE =================
        .form-group
          label(for="paymentType") Payment Type
          select#paymentType(name="paymentType" required)
            option(value="credit") Credit
            option(value="partial") Partial Payment

        // ================= AMOUNT PAID =================
        .form-group
          label(for="amountPaid") Amount Paid (UGX)
          input#amountPaid(
            type="number"
            name="amountPaid"
          )

        // ================= NOTES =================
        .form-group.full
          label(for="notes") Notes (Optional)
          textarea#notes(
            name="notes"
            rows="3"
            placeholder="Any extra details..."
          )

      // ================= BUTTON =================
      .form-actions
        button.btn(type="submit")
          i.fa-solid.fa-credit-card
          |  Save Credit Sale