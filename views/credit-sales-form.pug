extends admin-layout

block content

  .page-header
    h2 Credit Sales
    p Register customer purchases on credit

  .form-container

    form(method="POST" action="/admin/deposits")

      .form-grid

        .form-group
          label Customer Name
          input(type="text" name="customerName" required)

        .form-group
          label Customer Address
          input(type="text" name="customerAddress" required)

        .form-group
          label Customer Contact
          input(type="number" name="customerContact" required)

        .form-group
          label NIN Number
          input(type="text" name="nin")

        .form-group
          label Select Item
          select(name="itemId" required)
            option(value="" disabled selected) -- Select Product --
            each item in items
              option(value=item._id)
                | #{item.itemName} (Qty: #{item.quantity} | UGX #{item.sellingPrice})

        .form-group
          label Quantity
          input(type="number" name="quantity" required)

        .form-group
          label Payment Type
          select(name="paymentType" required)
            option(value="credit") Credit
            option(value="partial") Partial Payment

        .form-group
          label Amount Paid (UGX)
          input(type="number" name="amountPaid" value="0")

        .form-group.full
          label Notes
          textarea(name="notes" rows="3")

      .form-actions
        button.btn(type="submit")
          i.fa-solid.fa-credit-card
          | Save Credit Sale