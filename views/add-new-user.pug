extends admin-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Add New User
    p Create a new secure system user account

  // ================= FORM CONTAINER =================
  .form-section
    h3 Account Configuration Credentials

    form(method='POST' action='/admin/users/add' onsubmit='return validatePasswords()')

      .form-grid

        // ================= USERNAME =================
        .input-group
          label Username
          .icon-input-wrapper
            i.fa-solid.fa-user.input-icon
            input(type='text' name='username' placeholder='Enter username' required)

        // ================= EMAIL =================
        .input-group
          label Email Address
          .icon-input-wrapper
            i.fa-solid.fa-envelope.input-icon
            input(type='email' name='email' placeholder='Enter email' required)

        // ================= PHONE =================
        .input-group
          label Phone Number
          .icon-input-wrapper
            i.fa-solid.fa-phone.input-icon
            input(type='text' name='phoneNumber' placeholder='Enter phone number' required)

        // ================= NIN =================
        .input-group
          label NIN Number (Optional)
          .icon-input-wrapper
            i.fa-solid.fa-id-card.input-icon
            input(type='text' name='nin' placeholder='Enter National ID Number')

        // ================= ROLE =================
        .input-group
          label Access Assignment Role
          .icon-input-wrapper
            i.fa-solid.fa-user-gear.input-icon
            select(name='role' required)
              option(value='' disabled selected) Choose designated staff role...
              option(value='sales_attendant') Sales Attendant
              option(value='store_manager') Store Manager
              option(value='admin') Admin / Accounts

        // ================= PASSWORD =================
        .input-group
          label Password
          .icon-input-wrapper
            i.fa-solid.fa-lock.input-icon
            input(type='password' name='password' id='signupPassword' placeholder='Create strong password' required)
            span.toggle-password-icon(onclick='toggleFieldVisibility("signupPassword", this)')
              i.fa-solid.fa-eye

        // ================= CONFIRM PASSWORD =================
        .input-group
          label Confirm Password
          .icon-input-wrapper
            i.fa-solid.fa-shield-halved.input-icon
            input(type='password' name='confirmPassword' id='confirmPassword' placeholder='Confirm security password' required)
            span.toggle-password-icon(onclick='toggleFieldVisibility("confirmPassword", this)')
              i.fa-solid.fa-eye

      // ================= FORM SUBMIT SUB-BAR =================
      .form-actions-bar
        a.btn.action-btn(href="/admin/users") Cancel
        button.btn.action-btn.primary-action-btn(type='submit')
          i.fa-solid.fa-user-plus
          span Create User Account

  // ================= UTILITY INTERACTION SCRIPTS =================
  script.
    function toggleFieldVisibility(fieldId, element) {
      const field = document.getElementById(fieldId);
      const icon = element.querySelector('i');
      if (field.type === 'password') {
        field.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        field.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }

    function validatePasswords() {
      const p1 = document.getElementById('signupPassword').value;
      const p2 = document.getElementById('confirmPassword').value;
      if (p1 !== p2) {
        alert("❌ Error: Passwords do not match. Please verify values.");
        return false;
      }
      return true;
    }