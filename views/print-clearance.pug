extends stock-layout

block content
  .quick-actions.no-print
    button.btn.primary-btn(type="button" onclick="window.print()")
      i.fa-solid.fa-print
      |  Print Voucher

  .receipt-wrapper.clearance-border
    .paid-watermark Account Cleared

    .receipt-header
      .receipt-title-area
        h1.clearance-title Liability Clearance Voucher
        p Supplier Accounts Payable Settlement Receipt

      .receipt-logo-area
        h2.text-success PAID
        small Ref: VOUCH-#{item._id.toString().substring(18).toUpperCase()}

    .receipt-meta-grid
      .receipt-meta-block.clearance-bg
        strong Beneficiary (Supplier Account):
        p.font-semibold= item.supplierName || 'N/A'
        p.text-muted Company: #{item.companyName || 'N/A'}
        p Account Contact: #{item.supplierContact || 'N/A'}

      .receipt-meta-block.text-right
        strong Payment Parameters:
        p Settlement Date: #{new Date().toLocaleDateString('en-GB')}
        p Intake Batch Date: #{new Date(item.createdAt).toLocaleDateString('en-GB')}
        p.text-success Status: Closed Account

    table.receipt-table
      thead
        tr
          th Clear Ordered Item
          th.text-center Intake Batch Volume
          th.text-right Agreed Unit Price
          th.text-right Total Disbursed Balance
      tbody
        tr
          td.font-semibold= item.itemName
          td.text-center= item.originalQuantity || 0
          td.text-right UGX #{Number(item.buyingPrice || 0).toLocaleString()}
          td.text-right.text-success UGX #{Number((item.buyingPrice || 0) * (item.originalQuantity || 0)).toLocaleString()}
        tr.receipt-total-row
          td(colspan="2")
          td.text-right Total Paid out:
          td.text-right.text-success UGX #{Number((item.buyingPrice || 0) * (item.originalQuantity || 0)).toLocaleString()}

    .receipt-signatures
      .receipt-sig-line
        span.sig-label Disbursed By:
        span.sig-name= user ? user.fullname : 'Store Manager'
      .receipt-sig-line
        span.sig-label Received & Confirmed By:
        span.sig-name= item.supplierName || 'Supplier'