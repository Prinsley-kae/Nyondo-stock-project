doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Login - NYONDO Stock System

    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
    link(href='https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/css/style.css')

  body
    .auth-container
      .auth-box
        h2 Login
        p.subtitle Access your NYONDO account

        form(method='POST' action='/login')

          // EMAIL
          .input-group
            label Email
            .icon-input
              i.fa-solid.fa-envelope
              input(type='email' name='email' placeholder='Enter email' required)

          // PASSWORD WITH TOGGLE ICON
          .input-group
            label Password
            .password-wrapper
              input(type='password' name='password' id='loginPassword' placeholder='Enter password' required)
              span.toggle-password(onclick='toggleLoginPassword(event)')
                i.fa-solid.fa-eye

          button.btn.primary(type='submit')
            i.fa-solid.fa-right-to-bracket
            | Login

        .auth-links
          p
            | Don't have an account?
            a(href='/signup') Sign Up

    footer
      p © 2026 NYONDO General Hardware LTD
      p
        i.fa-solid.fa-location-dot
        | Nansana, Uganda

    script(src='/js/script.js')