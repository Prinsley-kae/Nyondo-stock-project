doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Admin Panel - NYONDO System

    //-Fonts & Icons
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet")

    //-Main CSS Module
    link(rel="stylesheet" href="/css/admin.css")

  body

    //- ================= WRAPPER =================
    .dashboard-wrapper

      //- ================= SIDEBAR =================
      aside.sidebar

        .brand
          h2 NYONDO HARDWARE
          p ADMIN PANEL

        ul.nav-links

          //- ================= DASHBOARD =================
          li(class=(currentPath === '/admin' ? 'active' : ''))
            a(href="/admin")
              i.fa-solid.fa-gauge
              span Dashboard

          //- ================= USER MANAGEMENT =================
          li(class=(currentPath === '/admin/users' ? 'active' : ''))
            a(href="/admin/users")
              i.fa-solid.fa-users
              span Users

          
          //- ================= CUSTOMER DEPOSITS =================
          li(class=(currentPath === '/admin/deposits' ? 'active' : ''))
            a(href="/admin/deposits")
              i.fa-solid.fa-wallet
              span Customer Deposits

          //- ================= DEPOSIT DETAILS =================
          li(class=(currentPath === '/admin/deposit-details' ? 'active' : ''))
            a(href="/admin/deposit-details")
              i.fa-solid.fa-receipt
              span Deposit Details

          //- ================= TRANSPORT RULES =================
          li(class=(currentPath === '/admin/transport-rules' ? 'active' : ''))
            a(href="/admin/transport-rules")
              i.fa-solid.fa-truck
              span Transport Rules
            
          //- ================= SETTINGS =================
          li(class=(currentPath === '/admin/settings' ? 'active' : ''))
            a(href="/admin/settings")
              i.fa-solid.fa-gear
              span Settings

          //- ================= AUTH =================
          li
            a(href="/logout")
              i.fa-solid.fa-right-from-bracket
              span Logout

      //- ================= MAIN CONTENT =================
      main.main-content

        //- ================= TOPBAR =================
        header.topbar

          .left
            h3 System Administrator Panel

          .right
            .user-info
              i.fa-solid.fa-user-shield
              span Admin

        //- ================= PAGE CONTENT =================
        section.content
          block content