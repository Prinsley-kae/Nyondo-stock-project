extends admin-layout

block content

  .admin-page-header
    h2.header-title Edit User Profile
    p.header-subtitle Modify account parameters, authorization scopes, and status profiles.

  .admin-card
    h3.card-title Account Configuration Credentials

    form(method='POST' action=`/admin/users/edit/${user._id}` novalidate)
      .form-grid
        
        //- ================= USERNAME =================
        .admin-input-group
          label Username (First Last)
          .input-container
            i.fa-solid.fa-user.icon
            input.admin-input(
              type='text' 
              name='username' 
              value=user.username 
              required 
              class=(errors && errors.username ? 'input-error' : '')
            )
          if errors && errors.username
            span.error-text= errors.username.msg

        //- ================= EMAIL =================
        .admin-input-group
          label Email Address
          .input-container
            i.fa-solid.fa-envelope.icon
            input.admin-input(
              type='email' 
              name='email' 
              value=user.email 
              required 
              class=(errors && errors.email ? 'input-error' : '')
            )
          if errors && errors.email
            span.error-text= errors.email.msg

        //- ================= PHONE =================
        .admin-input-group
          label Phone Number (+2567...)
          .input-container
            i.fa-solid.fa-phone.icon
            input.admin-input(
              type='text' 
              name='phonenumber' 
              value=(user.phonenumber || '') 
              pattern='\\+2567\\d{8}' 
              title='Must start with +2567 and be 12 digits' 
              required 
              class=(errors && errors.phonenumber ? 'input-error' : '')
            )
          if errors && errors.phonenumber
            span.error-text= errors.phonenumber.msg

        //- ================= NIN =================
        .admin-input-group
          label NIN Number
          .input-container
            i.fa-solid.fa-id-card.icon
            input.admin-input(
              type='text' 
              name='nin' 
              value=(user.nin || '') 
              pattern='[A-Z0-9]{14}' 
              title='14 alphanumeric characters (Uppercase)' 
              required 
              class=(errors && errors.nin ? 'input-error' : '')
            )
          if errors && errors.nin
            span.error-text= errors.nin.msg

        //- ================= ROLE =================
        .admin-input-group
          label System Authorization Role
          .input-container
            i.fa-solid.fa-user-gear.icon
            select.admin-input(
              name='role' 
              required 
              class=(errors && errors.role ? 'input-error' : '')
            )
              option(value='sales_attendant' selected=(user.role === 'sales_attendant')) Sales Attendant
              option(value='store_manager' selected=(user.role === 'store_manager')) Store Manager
              option(value='admin' selected=(user.role === 'admin')) Admin / Accounts
          if errors && errors.role
            span.error-text= errors.role.msg

        //- ================= STATUS =================
        .admin-input-group
          label Operational Status
          .input-container
            i.fa-solid.fa-toggle-on.icon
            select.admin-input(
              name='isActive'
              class=(errors && errors.isActive ? 'input-error' : '')
            )
              option(value='true' selected=(user.isActive === true)) Active
              option(value='false' selected=(user.isActive === false))  Inactive
          if errors && errors.isActive
            span.error-text= errors.isActive.msg

      //- ================= FORM ACTIONS =================
      .admin-form-actions
        a.btn-secondary(href='/admin/users') Cancel
        button.btn-primary(type='submit')
          i.fa-solid.fa-floppy-disk
          |  Update User

  //-- SCRIPTS
  script.
    //- 1. Client-side empty field validation
    document.querySelector('form').addEventListener('submit', function(e) {
      let hasError = false;
      const fields = this.querySelectorAll('.admin-input');

      fields.forEach(field => {
        if (field.value.trim() === '') {
          field.classList.add('input-error');
          hasError = true;
        }
      });

      if (hasError) {
        e.preventDefault();
        alert("Please fill in all required fields.");
      }
    });

    //- 2. Clear red lines when user starts typing
    document.querySelectorAll('.admin-input').forEach(input => {
      input.addEventListener('input', () => {
        input.classList.remove('input-error');
        const errorText = input.parentElement.parentElement.querySelector('.error-text');
        if (errorText) errorText.style.display = 'none';
      });
    });