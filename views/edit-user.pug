extends admin-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Edit User
    p Update user details

  // ================= FORM =================
  .form-container

    form(method='POST' action=`/admin/users/edit/${user._id}`)

      // ================= USERNAME =================
      .input-group
        label Username
        .icon-input
          i.fa-solid.fa-user
          input(
            type='text'
            name='username'
            value=user.username
            required
          )

      // ================= EMAIL =================
      .input-group
        label Email
        .icon-input
          i.fa-solid.fa-envelope
          input(
            type='email'
            name='email'
            value=user.email
            required
          )

      // ================= PHONE =================
      .input-group
        label Phone Number
        .icon-input
          i.fa-solid.fa-phone
          input(
            type='text'
            name='phoneNumber'
            value=user.phoneNumber || ''
            required
          )

      // ================= NIN =================
      .input-group
        label NIN Number (Optional)
        .icon-input
          i.fa-solid.fa-id-card
          input(
            type='text'
            name='nin'
            value=user.nin || ''
          )

      // ================= ROLE =================
      .input-group
        label Role
        select(name='role' required)

          option(
            value='sales_attendant'
            selected=user.role === 'sales_attendant'
          ) Sales Attendant

          option(
            value='store_manager'
            selected=user.role === 'store_manager'
          ) Store Manager

          option(
            value='admin'
            selected=user.role === 'admin'
          ) Admin / Accounts

      // ================= STATUS =================
      .input-group
        label Account Status
        select(name='isActive')

          option(
            value='true'
            selected=user.isActive === true
          ) Active

          option(
            value='false'
            selected=user.isActive === false
          ) Disabled

      // ================= BUTTON =================
      button.btn.primary(type='submit')
        i.fa-solid.fa-floppy-disk
        |  Update User

      a.btn.secondary(href='/admin/users')
        i.fa-solid.fa-arrow-left
        |  Back