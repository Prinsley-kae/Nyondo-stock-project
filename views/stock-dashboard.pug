extends stock-layout

block content
  //- Add this style block to ensure the grid handles 5 cards nicely
  style.
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }

  //- ================= PAGE HEADER =================
  .page-header
    h2 Store Manager Dashboard
    p Overview of stock, pricing, and supplier activity

  //- ================= SUMMARY CARDS =================
  .stats-grid
    .card
      i.fa-solid.fa-boxes-stacked
      .info
        h3 Total Stock
        p #{stats && stats.totalCurrentQuantity ? stats.totalCurrentQuantity.toLocaleString() : 0}

    .card
      i.fa-solid.fa-triangle-exclamation
      .info
        h3 Low Stock
        p #{stats && stats.lowStockItems ? stats.lowStockItems : 0}

    .card
      i.fa-solid.fa-coins
      .info
        h3 Inventory Value
        p UGX #{stats && stats.inventoryValue ? stats.inventoryValue.toLocaleString() : 0}

    .card
      i.fa-solid.fa-chart-line
      .info
        h3 Projected Profit
        p UGX #{stats && stats.projectedProfit ? stats.projectedProfit.toLocaleString() : 0}

    .card
      i.fa-solid.fa-truck-field
      .info
        h3 Suppliers
        p #{stats && stats.suppliers ? stats.suppliers : 0}

  //- ================= QUICK ACTIONS =================
  .quick-actions
  h3 Quick Actions & Reporting

  .action-buttons
    a.btn(href="/store/add-stock")
      i.fa-solid.fa-plus
      | Add Stock
    a.btn(href="/store/inventory")
      i.fa-solid.fa-boxes-stacked
      | View Stock
    a.btn(href="/store/credits")
      i.fa-solid.fa-tags
      | View Credits
    a.btn(href="/store/payment-history")
      i.fa-solid.fa-history
      | Payment History

  .action-buttons(style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 20px;")
    a.btn(href="/store/reports/inventory-valuation")
      i.fa-solid.fa-file-pdf
      | Inventory Valuation (PDF)
    a.btn(href="/store/reports/sales-movement")
      i.fa-solid.fa-chart-pie
      | Weekly Sales Movement
    a.btn(href="/store/reports/credit-liability")
      i.fa-solid.fa-file-invoice-dollar
      | Credit Liability

  //- ================= LOW STOCK SECTION =================
  .recent-section
    h3 Low Stock Items
    .table-responsive
      table
        thead
          tr
            th No.
            th Product Name
            th Remaining Stock
            th Alert Status
        tbody
          if lowStockItems && lowStockItems.length
            each item, i in lowStockItems
              tr
                td.text-center= i + 1
                td.font-semibold= item.itemName || 'N/A'
                td.font-bold= item.currentQuantity || 0
                td
                  if Number(item.currentQuantity) === 0
                    span.badge.out Out of Stock
                  else if Number(item.currentQuantity) <= 50
                    span.badge.critical Critical
                  else
                    span.badge.low Low Stock
          else
            tr
              td(colspan="3" style="text-align: center; color: #888; padding: 20px;")
                | No low stock alerts. All inventory levels normal.


                //- ================= SUCCESS MODAL =================
  #successModal.modal-overlay
    .modal-content
      h2 CONGRATULATIONS!
      p You have successfully signed into the Nyondo Hardware system. Feel at home.

  script.
    document.addEventListener("DOMContentLoaded", function() {
      const urlParams = new URLSearchParams(window.location.search);
      const modal = document.getElementById('successModal');

      if (urlParams.get('success') === 'true' && modal) {
        modal.style.display = 'flex';

        setTimeout(() => {
          modal.style.display = 'none';

          //- Clean URL to prevent reappearance on refresh
          window.history.replaceState({}, document.title, window.location.pathname);
        }, 3000);
      }
    });