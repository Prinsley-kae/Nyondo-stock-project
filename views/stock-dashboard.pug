extends stock-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Store Manager Dashboard
    p Overview of stock, pricing, and supplier activity

  // ================= SUMMARY CARDS =================
  .stats-grid

    .card
      i.fa-solid.fa-boxes-stacked
      .info
        h3 Total Stock Quantity
        p #{stats && stats.totalStockItems ? stats.totalStockItems : 0}

    .card
      i.fa-solid.fa-triangle-exclamation
      .info
        h3 Low Stock Alerts
        p #{stats && stats.lowStockItems ? stats.lowStockItems : 0}

    .card
      i.fa-solid.fa-coins
      .info
        h3 Inventory Value
        p UGX #{stats && stats.inventoryValue ? stats.inventoryValue.toLocaleString() : 0}

    .card
      i.fa-solid.fa-truck-field
      .info
        h3 Suppliers
        p #{stats && stats.suppliers ? stats.suppliers : 0}

  // ================= QUICK ACTIONS =================
  .quick-actions
    h3 Quick Actions

    .action-buttons

      a.btn.primary-btn(href="/store/add-stock")
        i.fa-solid.fa-plus
        |  Add Stock

      a.btn.secondary-btn(href="/store/inventory")
        i.fa-solid.fa-boxes-stacked
        |  View Stock

      a.btn.secondary-btn(href="/store/inventory")
        i.fa-solid.fa-tags
        |  View Credits

  // ================= LOW STOCK SECTION =================
  .recent-section
    h3 Low Stock Items

    .table-responsive
      table
        thead
          tr
            th Product Name
            th Remaining Stock
            th Alert Status

        tbody
          if lowStockItems && lowStockItems.length
            each item in lowStockItems
              tr
                td.font-semibold= item.itemName
                td= item.quantity
                td
                  if item.quantity == 0
                    span.badge.out Out of Stock
                  else if item.quantity <= 5
                    span.badge.critical Critical
                  else
                    span.badge.low Low Stock
          else
            tr
              td(colspan="3" style="text-align: center; color: #888; padding: 20px;") No low stock alerts. All inventory levels normal.