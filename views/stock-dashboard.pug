extends stock-layout

block content

  // ================= PAGE HEADER =================
  .page-header
    h2 Store Manager Dashboard
    p Overview of stock, pricing, and supplier activity

  // ================= SUMMARY CARDS =================
  .stats-grid

    .card
      i.fa-solid.fa-boxes-stacked
      .info
        h3 Total Stock Quantity
        p #{stats.totalStockItems}

    .card
      i.fa-solid.fa-triangle-exclamation
      .info
        h3 Low Stock Alerts
        p #{stats.lowStockItems}

    .card
      i.fa-solid.fa-coins
      .info
        h3 Inventory Value
        p UGX #{stats.inventoryValue.toLocaleString()}

    .card
      i.fa-solid.fa-truck-field
      .info
        h3 Suppliers
        p #{stats.suppliers}

  // ================= QUICK ACTIONS =================
  .quick-actions
    h3 Quick Actions

    .action-buttons

      a.btn(href="/store/add-stock")
        i.fa-solid.fa-plus
        | Add Stock

      a.btn.secondary(href="/store/inventory")
        i.fa-solid.fa-boxes-stacked
        | View Stock

      a.btn.secondary(href="/store/inventory")
        i.fa-solid.fa-tags
        | View Credits

  // ================= LOW STOCK SECTION =================
  .recent-section
    h3 Low Stock Items

    table
      thead
        tr
          th Product
          th Remaining Stock
          th Status

      tbody
        if lowStockItems && lowStockItems.length
          each item in lowStockItems
            tr
              td= item.itemName
              td= item.quantity

              td
                if item.quantity == 0
                  span.badge.out Out of Stock
                else if item.quantity <= 5
                  span.badge.low Critical
                else
                  span.badge.low Low Stock
        else
          tr
            td(colspan="3") No low stock alerts